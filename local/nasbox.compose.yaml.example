# Copy to a private compose.yaml; replace documentation-only address and public key.
# Deploy as the Container Manager project nasbox in /volume1/docker/nasbox.
services:
  dev:
    # mise installs Node in the home volume. The image gives Debian and build tools.
    image: node:latest
    # A build pulls the newest image. A restart keeps the current one.
    pull_policy: always
    container_name: nasbox
    hostname: nasbox
    restart: unless-stopped
    init: true
    dns:
      - 1.1.1.1
      - 8.8.8.8
    mem_limit: 6g
    memswap_limit: 6g
    ports:
      - "192.0.2.10:2222:22"
      - "3773:3773"
    volumes:
      - dev-home:/home/box
      - ./workspace:/workspace
      - ssh-host-keys:/var/lib/nasbox-ssh
      # USB phones for adb, agent-device, and the T3 device hub. The bind
      # mount also shows phones that you connect after the container starts.
      - /dev/bus/usb:/dev/bus/usb
    # 189 is the Linux major number of USB device nodes.
    device_cgroup_rules:
      - "c 189:* rwm"
    working_dir: /workspace
    command:
      - /bin/bash
      - -ec
      - |
        export DEBIAN_FRONTEND=noninteractive
        if ! command -v sshd >/dev/null || ! command -v sudo >/dev/null; then
          apt-get update
          apt-get install -y --no-install-recommends openssh-server sudo tmux procps iproute2 bubblewrap libatomic1
        fi
        if ! id box >/dev/null 2>&1; then
          id -u node | grep -qx 1000
          usermod -l box -d /home/box node
        fi
        if getent group node >/dev/null; then
          groupmod -n box node
        fi
        id -u box | grep -qx 1000
        id -g box | grep -qx 1000
        if test -L /home/node; then
          readlink /home/node | grep -qx /home/box
        else
          if test -e /home/node; then
            test ! -e /home/node.image-default
            mv /home/node /home/node.image-default
          fi
          ln -s /home/box /home/node
        fi
        mkdir -p /run/sshd /home/box/.ssh /workspace /var/lib/nasbox-ssh
        touch /home/box/.ssh/authorized_keys
        grep -q 'REPLACE_WITH_YOUR_ED25519_PUBLIC_KEY_BASE64' /home/box/.ssh/authorized_keys || echo 'ssh-ed25519 REPLACE_WITH_YOUR_ED25519_PUBLIC_KEY_BASE64 nasbox' >> /home/box/.ssh/authorized_keys
        chmod 700 /home/box/.ssh
        chmod 600 /home/box/.ssh/authorized_keys
        chown -R box:box /home/box /workspace
        passwd -d box
        install -d -m 0755 /etc/sudoers.d
        printf '%s\n' 'box ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/.90-nasbox-box.tmp
        chown root:root /etc/sudoers.d/.90-nasbox-box.tmp
        chmod 0440 /etc/sudoers.d/.90-nasbox-box.tmp
        visudo -cf /etc/sudoers.d/.90-nasbox-box.tmp
        mv -f /etc/sudoers.d/.90-nasbox-box.tmp /etc/sudoers.d/90-nasbox-box
        visudo -c
        su - box -c 'sudo -n id -u' | grep -qx 0
        printf '%s\n' 'box passwordless sudo verified'
        test -f /var/lib/nasbox-ssh/ssh_host_ed25519_key || ssh-keygen -q -t ed25519 -N '' -f /var/lib/nasbox-ssh/ssh_host_ed25519_key
        # The container has no udev, so each USB node opens only for root.
        # Give box the nodes of devices with an adb interface (class ff,
        # subclass 42, protocol 01), so an adb server that box starts sees the
        # phones. Other USB devices, such as the NAS's own, stay root-only.
        # The loop also covers phones connected later. A container gets no USB
        # plug events, so a running adb server never sees a new phone. When a
        # phone node is not in the known list, the loop restarts the server as
        # box, and the new server finds all phones. The list changes only
        # after a restart works, so a failed restart, or an SDK that setup has
        # not installed yet, is retried. $$ is a literal $ in Compose.
        adb=/home/box/Android/Sdk/platform-tools/adb
        known=
        while :; do
          nodes=
          for interface in /sys/bus/usb/devices/*:*; do
            test "$$(cat "$$interface/bInterfaceClass" "$$interface/bInterfaceSubClass" "$$interface/bInterfaceProtocol" 2>/dev/null | tr -d '\n')" = ff4201 || continue
            device="$${interface%:*}"
            node="$$(printf '/dev/bus/usb/%03d/%03d' "$$(cat "$$device/busnum")" "$$(cat "$$device/devnum")")" || continue
            nodes="$$nodes $$node"
            test "$$(stat -c %G:%a "$$node" 2>/dev/null)" != box:660 || continue
            chgrp box "$$node" && chmod 0660 "$$node" || echo "nasbox: cannot give $$node to box" >&2
          done
          new=0
          for node in $$nodes; do
            case "$$known " in *" $$node "*) ;; *) new=1 ;; esac
          done
          if test "$$new" = 0; then
            known=$$nodes
          elif test -x "$$adb"; then
            if su box -s /bin/sh -c "$$adb kill-server >/dev/null 2>&1; $$adb start-server" >/dev/null 2>&1; then
              known=$$nodes
            else
              echo 'nasbox: cannot restart adb' >&2
            fi
          fi
          sleep 2
        done &
        if test -x /home/box/code/personal/dotfiles/bin/container-system-packages; then
          su - box -c /home/box/code/personal/dotfiles/bin/container-system-packages &
        fi
        if test -x /home/box/.local/bin/t3-supervise; then
          su - box -c /home/box/.local/bin/t3-supervise &
        fi
        if test -x /home/box/.local/bin/tokenburnmarket-supervise; then
          su - box -c /home/box/.local/bin/tokenburnmarket-supervise &
        fi
        exec /usr/sbin/sshd -D -e -o HostKey=/var/lib/nasbox-ssh/ssh_host_ed25519_key -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no -o PermitRootLogin=no -o AllowUsers=box -o PrintMotd=no
# external keeps Compose from making or deleting the volumes.
volumes:
  dev-home:
    external: true
    name: nasbox_dev-home
  ssh-host-keys:
    external: true
    name: nasbox_ssh-host-keys
# CLIProxyAPI joins this network to serve agents on the box.
networks:
  default:
    name: nasbox

# Deploy as a separate NAS Container Manager project.
services:
  cliproxyapi:
    image: eceasy/cli-proxy-api:latest
    # A build pulls the newest image. A restart keeps the current one.
    pull_policy: always
    restart: unless-stopped
    command: ["./CLIProxyAPI", "--config", "/CLIProxyAPI/config/config.yaml"]
    environment:
      TZ: UTC
    ports:
      - "127.0.0.1:8317:8317"
    networks:
      - development
    volumes:
      - type: bind
        source: ./config
        target: /CLIProxyAPI/config
        bind:
          create_host_path: false
      - ./auths:/root/.cli-proxy-api
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
networks:
  development:
    external: true
    # The network of the nasbox project.
    name: nasbox

#!/bin/sh
# One-shot login job: share only the documented telemetry controls with launchd.
set -eu
settings="$HOME/.config/telemetry/env.sh"
# Merge only CRS properties already in launchd, as at login. Never the caller's.
AZ_CRS_ARGUMENTS=$(launchctl getenv AZ_CRS_ARGUMENTS 2>/dev/null) || AZ_CRS_ARGUMENTS=
[ -n "$AZ_CRS_ARGUMENTS" ] || unset AZ_CRS_ARGUMENTS
. "$settings"
while IFS= read -r line; do
  case "$line" in
    'export '*)
      definition=${line#export }
      name=${definition%%=*}
      case "$name" in ''|*[!A-Z0-9_]*) exit 2 ;; esac
      value=$(/usr/bin/printenv "$name")
      launchctl setenv "$name" "$value"
      ;;
    'unset _dotfiles_'*) ;; # Internal shell cleanup has no launchd keys.
    'unset '*)
      name=${line#unset }
      case "$name" in ''|*[!A-Z0-9_]*) exit 2 ;; esac
      launchctl unsetenv "$name"
      ;;
  esac
done < "$settings"

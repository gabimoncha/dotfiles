# Entries for the development Macs: the profiles that load the devhost layer,
# macowl and macmini. The root Brewfile has the entries for every Mac. Each
# third-party tap here was reviewed, as in the root Brewfile.
tap "felixkratz/formulae", trusted: true
tap "grishka/grishka", trusted: true
tap "homebrew-zathura/zathura", trusted: true
tap "nikitabobko/tap", trusted: true

brew "apktool"
brew "borders"
brew "gcc"
brew "ghostscript"
brew "glyph"
brew "grpc"
brew "homebrew-zathura/zathura/zathura-cb"
brew "homebrew-zathura/zathura/zathura-pdf-mupdf"
brew "postgresql@18"
brew "switchaudio-osx"
brew "telnet"
brew "zlib"

# Mac App Store
mas "DevCleaner for Xcode", id: 1388020431
mas "TestFlight", id: 899247664
mas "Transporter", id: 1450874784

cask "nikitabobko/tap/aerospace"
cask "blackhole-2ch"
cask "expo-orbit"
cask "karabiner-elements"
cask "neardrop"
cask "ngrok"
cask "orbstack"
cask "vorssaint"

#!/usr/bin/env bash
#MISE description="Run the existing app manifest action"
#MISE raw=true
#MISE dir="/"
set -euo pipefail
task_file="${BASH_SOURCE[0]}"
link_count=0
while :; do
  task_dir="$(cd -P "$(dirname "$task_file")" && pwd)"
  task_file="$task_dir/$(basename "$task_file")"
  [[ -L "$task_file" ]] || break
  link_count=$((link_count + 1))
  [[ "$link_count" -le 40 ]] || { printf 'Too many task file symlinks.\n' >&2; exit 1; }
  task_file="$(readlink "$task_file")"
  [[ "$task_file" == /* ]] || task_file="$task_dir/$task_file"
done
repo_root="$task_dir"
while [[ ! -f "$repo_root/bin/setup" || ! -d "$repo_root/mise/tasks" ]]; do
  [[ "$repo_root" != / ]] || { printf 'Cannot find the dotfiles repository from this task.\n' >&2; exit 1; }
  repo_root="$(dirname "$repo_root")"
done
cd "$repo_root"
exec "$repo_root/bin/install-apps" "$@"

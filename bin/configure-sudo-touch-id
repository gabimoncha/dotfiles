#!/usr/bin/env bash
# Enables Touch ID for sudo. The block is the [bootstrap.files] entry for
# /etc/pam.d/sudo_local in the profile's mise file (mise.macowl.toml); mise
# keeps it between its markers and leaves the other lines alone. This script
# adds what mise does not do: it checks that Apple's /etc/pam.d/sudo includes
# sudo_local, comments out an unmarked pam_tid.so line from an older setup,
# and turns Touch ID off with --disable.

set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

pam_dir=/etc/pam.d
sudo_file="${pam_dir}/sudo"
sudo_local_file="${pam_dir}/sudo_local"
marker_start='# >>> mise:touch-id >>>'
marker_end='# <<< mise:touch-id <<<'
mode="enable"
dry_run=0

log() {
  printf '==> %s\n' "$1"
}

warn() {
  printf '!! %s\n' "$1" >&2
}

usage() {
  cat <<'EOF' >&2
Usage: ./bin/configure-sudo-touch-id [--enable|--disable|--check] [--dry-run]

Enables or disables Touch ID for sudo through /etc/pam.d/sudo_local.
This script never edits Apple's managed /etc/pam.d/sudo file.
EOF
}

ensure_macos() {
  if [[ "$(uname)" == "Darwin" ]]; then
    return 0
  fi

  warn "Touch ID sudo authentication is only supported on macOS."
  return 1
}

sudo_includes_sudo_local() {
  [[ -f "$sudo_file" ]] || return 1

  awk '
    $1 == "auth" && $2 == "include" && $3 == "sudo_local" { found = 1 }
    END { exit found ? 0 : 1 }
  ' "$sudo_file"
}

ensure_supported() {
  if sudo_includes_sudo_local; then
    return 0
  fi

  warn "${sudo_file} does not include sudo_local."
  warn "Refusing to edit Apple's managed sudo PAM file."
  return 1
}

# Usage: count_tid_lines inside|outside. Counts the active pam_tid.so lines
# inside or outside the mise markers.
count_tid_lines() {
  [[ -f "$sudo_local_file" ]] || {
    printf '0\n'
    return 0
  }
  awk -v where="$1" -v start="$marker_start" -v end="$marker_end" '
    index($0, start) == 1 { inside = 1; next }
    index($0, end) == 1 { inside = 0; next }
    $1 == "auth" && $2 == "sufficient" && $3 == "pam_tid.so" {
      if ((where == "inside") == (inside == 1)) count++
    }
    END { print count + 0 }
  ' "$sudo_local_file"
}

touch_id_enabled() {
  [[ "$(count_tid_lines inside)" -gt 0 || "$(count_tid_lines outside)" -gt 0 ]]
}

# Usage: write_sudo_local WHAT AWK_PROGRAM. Backs up the file, then writes
# the output of the awk program as the new file.
write_sudo_local() {
  local what="$1" program="$2" temp_file backup
  temp_file="$(mktemp)"
  awk -v start="$marker_start" -v end="$marker_end" "$program" "$sudo_local_file" >"$temp_file"
  if [[ $dry_run -eq 1 ]]; then
    log "dry-run: would ${what} in ${sudo_local_file}"
    rm -f "$temp_file"
    return 0
  fi
  backup="${sudo_local_file}.dotfiles-backup-$(date +%Y%m%d%H%M%S)"
  log "Requesting administrator access to update ${sudo_local_file}"
  sudo cp -p "$sudo_local_file" "$backup"
  log "Backed up sudo_local to ${backup}"
  sudo install -o root -g wheel -m 0644 "$temp_file" "$sudo_local_file"
  rm -f "$temp_file"
}

# An older setup wrote an unmarked line. With the mise block too, a canceled
# Touch ID prompt would ask a second time.
comment_unmarked_lines() {
  [[ "$(count_tid_lines outside)" -gt 0 ]] || return 0
  write_sudo_local 'comment out the pam_tid.so line outside the mise block' '
    index($0, start) == 1 { inside = 1 }
    index($0, end) == 1 { inside = 0 }
    !inside && $1 == "auth" && $2 == "sufficient" && $3 == "pam_tid.so" { print "#" $0; next }
    { print }
  '
}

check_status() {
  ensure_macos
  ensure_supported

  if touch_id_enabled; then
    log "Touch ID for sudo is enabled"
    return 0
  fi

  warn "Touch ID for sudo is not enabled"
  return 1
}

enable() {
  local apply_flag=--yes
  ensure_macos
  ensure_supported
  [[ $dry_run -eq 0 ]] || apply_flag=--dry-run

  if [[ -f "$sudo_local_file" ]]; then
    comment_unmarked_lines
  fi
  # mise uses sudo for the write, and creates a missing file.
  "${repo_root}/bin/repo-mise" bootstrap files apply "$apply_flag"
  [[ $dry_run -eq 0 ]] || return 0

  if [[ "$(count_tid_lines inside)" -eq 0 ]]; then
    warn "Touch ID sudo setup did not verify. Does this profile's mise file declare the touch-id block?"
    return 1
  fi
  log "Touch ID for sudo is enabled"
}

# mise has no command that removes a block, so this comments out every
# pam_tid.so line. The next --enable or `mise bootstrap files apply` writes
# the block again.
disable() {
  ensure_macos
  ensure_supported

  if ! touch_id_enabled; then
    log "Touch ID for sudo is already disabled"
    return 0
  fi
  write_sudo_local 'comment out every pam_tid.so line' '
    $1 == "auth" && $2 == "sufficient" && $3 == "pam_tid.so" { print "#" $0; next }
    { print }
  '
  [[ $dry_run -eq 1 ]] || log "Touch ID for sudo is disabled"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --enable)
      mode="enable"
      shift
      ;;
    --disable)
      mode="disable"
      shift
      ;;
    --check)
      mode="check"
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

case "$mode" in
  check) check_status ;;
  enable) enable ;;
  disable) disable ;;
esac

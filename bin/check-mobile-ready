#!/usr/bin/env bash
# Read-only: never runs sudo, downloads, installs, or changes the selected Xcode.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=bin/lib/mobile-state.sh
. "${repo_root}/bin/lib/mobile-state.sh"
failures=0

pass() {
  printf 'ok  - %s\n' "$1"
}

fail() {
  printf 'fail - %s\n' "$1"
  failures=$((failures + 1))
}

if xcode_app="$(mobile_selected_xcode_app)"; then
  pass "full Xcode is selected: ${xcode_app}"
  if mobile_xcode_is_public "$xcode_app"; then
    pass "selected Xcode is a public build: $(mobile_xcode_build "$xcode_app")"
  else
    fail "selected Xcode is a prerelease or its build is unknown"
  fi
  if mobile_ios_sdk_ready; then
    pass "iOS simulator SDK is available"
  else
    fail "iOS simulator SDK is unavailable (license, first launch, or iOS platform is incomplete)"
  fi
  if mobile_ios_runtime_ready; then
    pass "an iOS simulator runtime is available"
  else
    fail "no available iOS simulator runtime"
  fi
else
  fail "full Xcode is not selected (xcode-select -p: $(xcode-select -p 2>/dev/null || printf none))"
fi

if mobile_android_studio_ready; then
  pass "Android Studio is installed"
else
  fail "Android Studio is not installed"
fi

if [[ -x "${mobile_java_home}/bin/java" ]]; then
  pass "JDK for Android builds: ${mobile_java_home}"
else
  fail "no JDK at ${mobile_java_home}"
fi
while IFS= read -r package; do
  if mobile_android_package_installed "$package"; then
    pass "Android SDK package ${package} is installed"
  else
    fail "Android SDK package ${package} is not in ${mobile_android_sdk_root}"
  fi
done < <(mobile_android_packages)
if mobile_android_metrics_off; then
  pass "Android CLI metrics are off in ~/.androidrc"
else
  fail "~/.androidrc does not turn off Android CLI metrics"
fi
if mobile_android_license_accepted; then
  pass "Android SDK license is accepted"
else
  fail "Android SDK license is not accepted"
fi
if adb_version="$("$mobile_adb" version 2>/dev/null | head -n 1)" && [[ -n "$adb_version" ]]; then
  pass "adb runs: ${adb_version}"
else
  fail "adb does not run from ${mobile_adb}"
fi
# A second adb, such as Homebrew's android-platform-tools, fights over the
# device server. Skip this when the SDK is not on PATH, as in setup.
adb_on_path="$(command -v adb 2>/dev/null || true)"
if [[ -n "$adb_on_path" && "$adb_on_path" != "$mobile_adb" ]]; then
  fail "adb on PATH is ${adb_on_path}, not ${mobile_adb}"
fi

if command -v brew >/dev/null 2>&1; then
  while IFS= read -r formula; do
    if mobile_formula_installed "$formula"; then
      pass "formula ${formula} is installed"
    else
      fail "formula ${formula} is not installed"
    fi
  done < <(mobile_formulae)
else
  fail "brew is not on PATH; cannot check apps/mobile.Brewfile formulae"
fi

if [[ "$failures" -gt 0 ]]; then
  printf '\nMobile setup is incomplete (%s issue(s)). Run ./bin/install-mobile-dev, or see SETUP-AGENT.md.\n' "$failures"
  exit 1
fi
printf '\nMobile setup is ready.\n'

#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
manifest="${repo_root}/apps/manifest.tsv"
. "${repo_root}/bin/lib/setup-runtime.sh"
for runtime_argument in "$@"; do
  [[ "$runtime_argument" != --dry-run ]] || DOTFILES_RUN_MODE=dry-run
done
unset runtime_argument
runtime_init "install-apps"
install_status=0
manual_count=0
dry_run=0
mise_bin_dir="${HOME}/.local/bin"
mise_shim_dir="${HOME}/.local/share/mise/shims"

log() {
  printf '==> %s\n' "$1"
}

warn() {
  printf '!! %s\n' "$1" >&2
}

load_homebrew_shellenv() {
  if [[ -n "${HOMEBREW_PREFIX:-}" && -x "${HOMEBREW_PREFIX}/bin/brew" ]]; then
    eval "$("${HOMEBREW_PREFIX}/bin/brew" shellenv)"
    return 0
  fi

  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  elif command -v brew >/dev/null 2>&1; then
    eval "$(brew shellenv)"
  fi
}

prepend_mise_shims() {
  local path_entry
  local new_path="${mise_bin_dir}:${mise_shim_dir}"
  local path_entries=()

  IFS=':' read -r -a path_entries <<< "$PATH"
  for path_entry in "${path_entries[@]}"; do
    [[ -z "$path_entry" ]] && continue
    case "$path_entry" in
      "$mise_bin_dir" | "$mise_shim_dir") continue ;;
    esac
    new_path="${new_path}:${path_entry}"
  done

  export PATH="$new_path"
}

app_installed() {
  local app_bundle="$1"
  [[ -n "$app_bundle" && "$app_bundle" != "-" && -d "/Applications/${app_bundle}.app" ]]
}

install_cask() {
  local token="$1"
  local app_bundle="$2"

  if app_installed "$app_bundle"; then
    log "${app_bundle}.app already exists"
    return 0
  fi

  if brew list --cask "$token" >/dev/null 2>&1; then
    log "cask ${token} already installed"
    return 0
  fi

  if [[ $dry_run -eq 1 ]]; then
    log "dry-run: would install cask ${token}"
    return 0
  fi

  log "Installing cask ${token}"
  runtime_with_lock homebrew brew install --cask "$token"
}

install_formula() {
  local token="$1"

  if ! command -v brew >/dev/null 2>&1; then
    warn "Homebrew is required to install formula ${token}"
    return 1
  fi

  if brew list --formula "$token" >/dev/null 2>&1; then
    log "formula ${token} already installed"
    return 0
  fi

  if [[ $dry_run -eq 1 ]]; then
    log "dry-run: would install formula ${token}"
    return 0
  fi

  log "Installing formula ${token}"
  runtime_with_lock homebrew brew install "$token"
}

install_mise_tool() {
  local token="$1"

  if ! command -v mise >/dev/null 2>&1; then
    warn "mise is required to install ${token}"
    return 1
  fi

  if [[ $dry_run -eq 1 ]]; then
    log "dry-run: would ensure mise tool ${token}"
    return 0
  fi

  if [[ "${DOTFILES_SETUP_API_READY:-0}" != 1 ]]; then
    warn "Verified setup GitHub API access is required before installing mise manifest tools; run ./bin/setup."
    return 1
  fi

  log "Ensuring mise tool ${token}"
  runtime_with_lock mise install_mise_tool_unlocked "$token"
}

install_mise_tool_unlocked() {
  local status=0 refresh_status=0
  (cd "$repo_root" && mise install "$1") || status=$?
  (cd "$repo_root" && mise reshim) || refresh_status=$?
  [[ "$status" -ne 0 ]] || status="$refresh_status"
  return "$status"
}

report_manual() {
  local key="$1"
  local url="$2"
  local app_bundle="$3"
  local notes="$4"

  if app_installed "$app_bundle"; then
    log "${app_bundle}.app already exists"
    return 0
  fi

  manual_count=$((manual_count + 1))
  cat <<EOF

Manual app: ${key}
URL: ${url}
Notes: ${notes}
EOF
}

if [[ "${1:-}" == "--dry-run" ]]; then
  dry_run=1
elif [[ $# -gt 0 ]]; then
  warn "Usage: ./bin/install-apps [--dry-run]"
  exit 1
fi

if [[ ! -f "$manifest" ]]; then
  warn "Missing app manifest: ${manifest}"
  exit 1
fi

load_homebrew_shellenv
prepend_mise_shims

while IFS=$'\t' read -r key type token_or_url app_bundle notes || [[ -n "${key:-}" ]]; do
  [[ -z "${key:-}" || "$key" == \#* ]] && continue

  case "$type" in
    cask)
      if ! command -v brew >/dev/null 2>&1; then
        warn "Homebrew is required to install ${key}"
        install_status=1
        continue
      fi
      install_cask "$token_or_url" "$app_bundle" || install_status=1
      ;;
    formula)
      install_formula "$token_or_url" || install_status=1
      ;;
    mise)
      install_mise_tool "$token_or_url" || install_status=1
      ;;
    manual)
      report_manual "$key" "$token_or_url" "$app_bundle" "$notes"
      ;;
    *)
      warn "Unknown app type '${type}' for ${key}"
      ;;
  esac
done < "$manifest"

if [[ $manual_count -gt 0 ]]; then
  cat <<'EOF'

Manual/Codex-assisted apps remain.
After bootstrap ensures Codex, use it to drive the vendor download flow where a stable package source is unavailable.
EOF
fi

log "App install pass finished (status ${install_status})"
exit "$install_status"

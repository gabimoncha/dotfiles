#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "${repo_root}/bin/lib/setup-runtime.sh"
. "${repo_root}/bin/lib/mise-pin.sh"
for runtime_argument in "$@"; do
  [[ "$runtime_argument" != --dry-run ]] || DOTFILES_RUN_MODE=dry-run
done
unset runtime_argument
runtime_init "ensure-mise-standalone"
dry_run=0
skip_update=1
mise_bin="${MISE_INSTALL_PATH:-${HOME}/.local/bin/mise}"
mise_bin_dir="$(dirname "$mise_bin")"

log() {
  printf '==> %s\n' "$1"
}

warn() {
  printf '!! %s\n' "$1" >&2
}

usage() {
  printf 'Usage: ./bin/ensure-mise-standalone [--dry-run] [--skip-update] [--update]\n' >&2
}

load_homebrew_shellenv() {
  if [[ -n "${HOMEBREW_PREFIX:-}" && -x "${HOMEBREW_PREFIX}/bin/brew" ]]; then
    eval "$("${HOMEBREW_PREFIX}/bin/brew" shellenv)"
    return 0
  fi

  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  elif command -v brew >/dev/null 2>&1; then
    eval "$(brew shellenv)"
  fi
}

# The repo config and mise/setup.toml need the pinned release or newer.
standalone_mise_ok() {
  local version
  [[ -x "$mise_bin" ]] || return 1
  if ! version="$(mise_installed_version "$mise_bin")"; then
    log "Cannot read the version of ${mise_bin}"
    return 1
  fi
  if ! mise_version_at_least "$version" "$pinned_mise_version"; then
    log "mise ${version} is older than the pinned ${pinned_mise_version}"
    return 1
  fi
}

brew_mise_installed() {
  load_homebrew_shellenv

  if ! command -v brew >/dev/null 2>&1; then
    return 1
  fi

  brew list --formula --versions mise >/dev/null 2>&1
}

install_standalone_mise() {
  if [[ "$dry_run" -eq 1 ]]; then
    log "dry-run: would install verified pinned mise v${pinned_mise_version} release"
    return 0
  fi

  log "Installing mise standalone"
  mkdir -p "$mise_bin_dir"
  local installer_dir installer real_curl digest status=0
  real_curl="$(command -v curl)" || return 1
  [[ "$real_curl" == /* && -x "$real_curl" ]] || return 1
  installer_dir="$(mktemp -d)" || return 1
  installer="${installer_dir}/install.sh"
  # Release asset digest is published in GitHub's official release metadata.
  "$real_curl" -fsSL --connect-timeout 15 --max-time 120 --retry 2 --retry-max-time 180 \
    "https://github.com/jdx/mise/releases/download/v${pinned_mise_version}/install.sh" -o "$installer" || status=$?
  if [[ "$status" -eq 0 ]]; then
    digest="$(shasum -a 256 "$installer")" || status=$?
    digest="${digest%% *}"
    if [[ "$digest" != "$pinned_installer_sha256" ]]; then
      warn "Pinned mise installer checksum mismatch; refusing to execute it"
      status=1
    fi
  fi
  if [[ "$status" -eq 0 ]]; then
    # The pinned installer invokes PATH curl for its asset download. Bound those
    # requests too, using the absolute pre-wrapper executable to avoid recursion.
    cat > "${installer_dir}/curl" <<'CURL'
#!/bin/sh
exec "$DOTFILES_INSTALLER_CURL" --connect-timeout 15 --max-time 300 --retry 2 --retry-max-time 600 "$@"
CURL
    chmod 700 "${installer_dir}/curl" || status=$?
  fi
  if [[ "$status" -eq 0 ]]; then
    PATH="${installer_dir}:${PATH}" DOTFILES_INSTALLER_CURL="$real_curl" \
      MISE_VERSION="v${pinned_mise_version}" MISE_INSTALL_PATH="$mise_bin" MISE_INSTALL_HELP=0 sh "$installer" || status=$?
  fi
  rm -rf "$installer_dir"
  return "$status"
}

verify_standalone_mise() {
  local mise_path mise_version

  export PATH="${mise_bin_dir}:${PATH}"
  hash -r 2>/dev/null || true

  mise_path="$(command -v mise || true)"
  if [[ "$mise_path" != "$mise_bin" ]]; then
    warn "mise resolves to ${mise_path:-missing}, expected ${mise_bin}"
    return 1
  fi

  if ! mise --version >/dev/null 2>&1; then
    warn "mise --version failed for ${mise_bin}"
    return 1
  fi

  if ! mise self-update --help >/dev/null 2>&1; then
    warn "mise self-update --help is unavailable; mise may still be package-manager owned"
    return 1
  fi

  mise_version="$(mise --version)"
  log "mise command: ${mise_path}"
  log "mise version: ${mise_version}"
  log "mise self-update is available"
}

update_standalone_mise() {
  log "Updating standalone mise"
  "$mise_bin" self-update --yes --no-plugins
}

uninstall_brew_mise() {
  if ! brew_mise_installed; then
    return 0
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    log "dry-run: would uninstall Homebrew formula mise after standalone verification succeeds"
    return 0
  fi

  log "Uninstalling Homebrew formula mise"
  runtime_with_lock homebrew brew uninstall mise
  hash -r 2>/dev/null || true
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=1
      shift
      ;;
    --update)
      skip_update=0
      shift
      ;;
    --skip-update)
      skip_update=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

export PATH="${mise_bin_dir}:${PATH}"

if standalone_mise_ok; then
  log "mise standalone install is already present"
else
  runtime_with_lock mise install_standalone_mise
fi

if [[ "$dry_run" -eq 1 ]]; then
  if [[ "$skip_update" -eq 1 ]]; then
    log "dry-run: would verify mise without updating it"
  else
    log "dry-run: would verify and update standalone mise"
  fi
  uninstall_brew_mise
  exit 0
fi

verify_standalone_mise
if [[ "$skip_update" -eq 0 ]]; then
  runtime_with_lock mise update_standalone_mise
  verify_standalone_mise
fi
uninstall_brew_mise
verify_standalone_mise

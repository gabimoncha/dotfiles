#!/usr/bin/env bash
# Install the Xcode, iOS, and Android toolchain. Each step skips finished work,
# so a rerun continues after a failure. It runs without prompts while a sudo
# timestamp is valid (see bin/sudo-grant) and the App Store is signed in.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=bin/lib/mobile-state.sh
. "${repo_root}/bin/lib/mobile-state.sh"
. "${repo_root}/bin/lib/setup-runtime.sh"
dry_run=0
status=0

log() {
  printf '==> %s\n' "$1"
}

warn() {
  printf '!! %s\n' "$1" >&2
}

run() {
  if [[ "$dry_run" -eq 1 ]]; then
    log "dry-run: would run: $*"
    return 0
  fi
  "$@"
}

resolve_mas() {
  local candidate
  candidate="$(command -v mas 2>/dev/null || true)"
  # sudo cannot resolve a mise shim, so pass the real binary.
  case "$candidate" in
    *'/shims/'*) candidate="$("$repo_root/bin/repo-mise" --global which mas 2>/dev/null)" || return 1 ;;
  esac
  [[ -n "$candidate" && -x "$candidate" ]] || return 1
  printf '%s\n' "$candidate"
}

install_xcode() {
  local mas_bin

  if mobile_selected_xcode_app >/dev/null || mobile_xcode_complete "${mobile_applications_dir}/Xcode.app"; then
    log "Xcode is installed"
    return 0
  fi
  if ! mas_bin="$(resolve_mas)"; then
    warn "mas is unavailable. It comes from the mise inventory; run ./bin/check-mise-tools."
    return 1
  fi
  log "Installing Xcode from the App Store; this is a large download"
  # get also works for an Apple ID that never downloaded Xcode; install does not.
  if ! run sudo "$mas_bin" get "$mobile_xcode_app_store_id"; then
    warn "The App Store did not install Xcode. Sign in to the App Store app, then rerun ./bin/install-mobile-dev."
    return 1
  fi
}

configure_xcode() {
  local xcode_app selected=1

  if ! xcode_app="$(mobile_selected_xcode_app)"; then
    xcode_app="${mobile_applications_dir}/Xcode.app"
    selected=0
  fi
  # Check before selecting, so a prerelease never becomes the active Xcode.
  if [[ -d "$xcode_app" ]] && ! mobile_xcode_is_public "$xcode_app"; then
    warn "${xcode_app} is a prerelease or its build is unknown. Install the public release."
    return 1
  fi
  if [[ "$dry_run" -eq 1 ]]; then
    log "dry-run: would select ${xcode_app}, accept its license, and run first launch if needed"
    return 0
  fi
  if [[ "$selected" -eq 0 ]]; then
    log "Selecting ${xcode_app}"
    sudo xcode-select -s "${xcode_app}/Contents/Developer" || return 1
  fi
  if ! sudo xcodebuild -license check >/dev/null 2>&1; then
    log "Accepting the Xcode license"
    sudo xcodebuild -license accept || return 1
  fi
  if ! sudo xcodebuild -checkFirstLaunchStatus >/dev/null 2>&1; then
    log "Running Xcode first launch tasks"
    sudo xcodebuild -runFirstLaunch || return 1
  fi
}

install_ios_platform() {
  if mobile_ios_sdk_ready && mobile_ios_runtime_ready; then
    log "iOS platform support is installed"
    return 0
  fi
  log "Installing iOS platform support"
  run sudo xcodebuild -downloadPlatform iOS
}

install_android_studio() {
  if mobile_android_studio_ready; then
    log "Android Studio is installed"
    return 0
  fi
  run runtime_with_lock homebrew brew install --cask android-studio
}

install_formulae() {
  local formula missing=0

  while IFS= read -r formula; do
    mobile_formula_installed "$formula" || missing=1
  done < <(mobile_formulae)
  if [[ "$missing" -eq 0 ]]; then
    log "Formulae in apps/mobile.Brewfile are installed"
    return 0
  fi
  run runtime_with_lock homebrew brew bundle install --no-upgrade --file "${repo_root}/apps/mobile.Brewfile"
}

case "${1:-}" in
  "") ;;
  --dry-run) dry_run=1 ;;
  -h | --help) printf 'Usage: ./bin/install-mobile-dev [--dry-run]\n'; exit 0 ;;
  *) printf 'Usage: ./bin/install-mobile-dev [--dry-run]\n' >&2; exit 1 ;;
esac

if [[ "${EUID}" -eq 0 ]]; then
  warn "Run ./bin/install-mobile-dev as your normal user, not with sudo."
  exit 1
fi
if ! command -v brew >/dev/null 2>&1; then
  warn "brew is not on PATH. Run ./bin/setup first."
  exit 1
fi
[[ "$dry_run" -eq 0 ]] || DOTFILES_RUN_MODE=dry-run
runtime_init install-mobile-dev
# The Xcode download can outlast the 30-minute sudo timestamp. Keep it valid
# while this script runs, also in an agent shell without setup's keepalive.
if [[ "$dry_run" -eq 0 ]] && sudo -n true 2>/dev/null; then
  owner=$$
  (while kill -0 "$owner" 2>/dev/null && sudo -n true; do sleep 60; done) >/dev/null 2>&1 &
fi

# Later Xcode steps need the earlier ones. Android Studio does not need Xcode.
if install_xcode && configure_xcode; then
  install_ios_platform || status=1
  install_formulae || status=1
else
  status=1
fi
install_android_studio || status=1

if [[ "$dry_run" -eq 1 ]]; then
  exit "$status"
fi
"${repo_root}/bin/check-mobile-ready" || status=1
exit "$status"

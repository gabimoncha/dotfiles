#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dry_run=0
for argument in "$@"; do
  case "$argument" in
    --dry-run) dry_run=1 ;;
    --skip-mobile-dev | --continue) ;;
    -h | --help)
      printf 'Usage: dotfiles-update [--dry-run] [--skip-mobile-dev]\n'
      exit 0
      ;;
    *)
      printf 'Unknown update argument: %s\n' "$argument" >&2
      exit 2
      ;;
  esac
done
. "${repo_root}/bin/lib/dotfiles-profile.sh"
DOTFILES_PROFILE="$(dotfiles_profile)" || exit 1
export DOTFILES_PROFILE

log() {
  printf '==> %s\n' "$1"
}

log "Updating dotfiles repo"
if [[ "$dry_run" == 1 ]]; then
  log "Would run git pull --ff-only"
else
  git -C "$repo_root" pull --ff-only
fi

log "Running setup"
DOTFILES_SKIP_MACOS_DEFAULTS=1 "${repo_root}/bin/setup" --continue "$@"

# mise bootstrap repos update always fetches tags. Its CLI reference has no
# option to skip them. Use repos exec to pull each current, unpinned branch.
# fleet updates only through `mise run fleet:apply`, which writes its stamp.
log "Updating the shell framework checkouts"
current_repos=()
repos_listed=0
if repo_list="$("${repo_root}/bin/repo-mise" bootstrap repos status --json |
  /usr/bin/ruby -rjson -e '
    JSON.parse(STDIN.read).fetch("repos").each do |repo|
      next if repo["path"].end_with?("/code/personal/fleet")
      puts repo["path"] if repo["state"] == "current" && repo["ref"].nil?
    end
  ')"; then
  repos_listed=1
  while IFS= read -r path; do
    [[ -n "$path" ]] && current_repos+=("$path")
  done <<<"$repo_list"
fi
if [[ "$repos_listed" == 0 ]]; then
  printf 'Could not list the shell checkouts. Run: ./bin/repo-mise bootstrap repos status\n' >&2
elif [[ ${#current_repos[@]} -eq 0 ]]; then
  log "No shell framework checkout to update"
else
  repo_exec=(bootstrap repos exec)
  [[ "$dry_run" != 1 ]] || repo_exec+=(--dry-run)
  "${repo_root}/bin/repo-mise" "${repo_exec[@]}" "${current_repos[@]}" -- sh -ec '
    changes="$(git status --porcelain)"
    if [ -n "$changes" ]; then
      printf "Skipping %s because it has local changes.\n" "$PWD" >&2
      exit 0
    fi
    branch="$(git branch --show-current)"
    if [ -z "$branch" ]; then
      printf "Skipping %s because HEAD is detached.\n" "$PWD" >&2
      exit 0
    fi
    exec git pull --ff-only --no-tags --no-prune origin "refs/heads/$branch"
  ' || printf 'Could not update the shell checkouts. See the Git output above.\n' >&2
fi

# Setup installs missing system packages only. Only Linux has entries.
if [[ "$(uname -s)" == Linux ]]; then
  log "Upgrading the apt packages in the mise files"
  if [[ "$dry_run" == 1 ]]; then
    "${repo_root}/bin/repo-mise" bootstrap packages upgrade --dry-run
  else
    "${repo_root}/bin/repo-mise" bootstrap packages upgrade --yes ||
      printf 'Could not upgrade the apt packages. Rerun: ./bin/repo-mise bootstrap packages upgrade\n' >&2
  fi
fi
[[ "$dry_run" == 1 ]] || "${repo_root}/bin/save-lock" || true

log "Dotfiles update complete"

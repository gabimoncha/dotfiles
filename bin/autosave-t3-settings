#!/usr/bin/env bash
# Save the public T3 settings into this repository when T3 changes them.
# A login job in mise.macowl.toml runs this every minute through the
# ~/bin/dotfiles-t3-autosave link. It writes configs/t3/settings.json and
# never commits. Review and commit the change yourself.
#
# Usage: autosave-t3-settings
#
# It runs bin/save-settings only when the live file differs from the last
# file that it saved. When a save fails, it shows one macOS notification for
# that version of the file and tries again at the next run. The log is
# .local/settings-sync/t3-autosave.log.
set -uo pipefail

# The job starts this script through a link in ~/bin.
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
repo_root="$(cd "$(dirname "$self")/.." && pwd -P)"

live="$HOME/.t3/userdata/settings.json"
state_dir="$repo_root/.local/settings-sync"
saved_stamp="$state_dir/t3-autosave.sha256"
failed_stamp="$state_dir/t3-autosave-failed.sha256"
log="$state_dir/t3-autosave.log"

[[ -f "$live" && ! -L "$live" ]] || exit 0
mkdir -p "$state_dir" || exit 1
current="$(/usr/bin/ruby -rdigest -e 'print Digest::SHA256.file(ARGV[0]).hexdigest' "$live")" || exit 1
[[ "$current" != "$(cat "$saved_stamp" 2>/dev/null)" ]] || exit 0

# Keep the log short. The messages name only setting paths, not values.
if [[ -f "$log" && "$(wc -l < "$log")" -gt 400 ]]; then
  tail -n 200 "$log" > "$log.new" && mv "$log.new" "$log"
fi
printf '%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" >> "$log"
if "$repo_root/bin/save-settings" "$live" >> "$log" 2>&1; then
  printf '%s' "$current" > "$saved_stamp"
  rm -f "$failed_stamp"
  exit 0
fi

# One notification for each failed version of the file.
if [[ "$current" != "$(cat "$failed_stamp" 2>/dev/null)" ]]; then
  printf '%s' "$current" > "$failed_stamp"
  /usr/bin/osascript -e 'display notification "Could not save the T3 settings. See .local/settings-sync/t3-autosave.log in the dotfiles repository." with title "dotfiles"' >/dev/null 2>&1 || true
fi
exit 1

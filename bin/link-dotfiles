#!/usr/bin/env bash
# Apply this machine's managed files with mise: the [dotfiles] entries in
# mise.toml, mise.macos.toml or mise.linux.toml, and the profile's file.
#
# mise refuses to put a link where a real file or folder is, and one refused
# entry stops the whole apply. mise also overwrites copies and templates and
# writes merged keys into settings files. Before mise changes a target, this
# script saves the old file or link in ~/.dotfiles-backups/links-<time>-*/.
# If the apply fails, it moves the saved files back.
#
# Usage: link-dotfiles [--status | --diff | --dry-run] [--skip-agents] [TARGET...]
#   --status       Exit 1 when an entry is missing or differs.
#   --skip-agents  Apply everything except ~/.claude and ~/.codex. Setup applies
#                  those after the Codex restore, which needs them absent.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() { printf 'Usage: link-dotfiles [--status | --diff | --dry-run] [--skip-agents] [TARGET...]\n'; }
mode=apply
skip_agents=0
targets=()
for argument in "$@"; do
  case "$argument" in
    --status|--diff|--dry-run)
      [[ "$mode" == apply ]] || { usage >&2; exit 2; }
      mode="${argument#--}"
      ;;
    --skip-agents) skip_agents=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) usage >&2; exit 2 ;;
    *) targets+=("$argument") ;;
  esac
done

# Check the profile before this script writes logs or takes a lock.
. "$repo_root/bin/lib/dotfiles-profile.sh"
DOTFILES_PROFILE="$(dotfiles_profile "$repo_root")" || exit
export DOTFILES_PROFILE

repo_mise() { "$repo_root/bin/repo-mise" "$@"; }
home_name() { printf '~/%s' "${1#"$HOME"/}"; }

# One line per target: state, mode ("merge" for merged keys), and path. Two
# merges into one file give one line, with the state that needs the most work.
read_status() {
  local json
  json="$(repo_mise dot status --json)" || return
  printf '%s' "$json" | /usr/bin/ruby -rjson -e '
    home = ENV.fetch("HOME")
    data = JSON.parse($stdin.read)
    rows = data.fetch("files").map { |row| [row.fetch("state"), row.fetch("mode"), row.fetch("target")] } +
           data.fetch("edits").map { |row| [row.fetch("state"), "merge", row.fetch("path")] }
    order = %w[applied missing differs]
    rows.group_by { |_, _, target| target }.each do |target, entries|
      states = entries.map(&:first)
      unknown = states - order
      abort "link-dotfiles: unknown state #{unknown.first} for #{target}" unless unknown.empty?
      abort "link-dotfiles: #{target} has a file entry and a merge" if entries.map { |entry| entry[1] }.uniq.size > 1
      target = File.join(home, target[2..-1]) if target.start_with?("~/")
      abort "link-dotfiles: a target is outside HOME: #{target}" unless target.start_with?(home + "/") && !target.include?("\t")
      puts [states.max_by { |state| order.index(state) }, entries.first[1], target].join("\t")
    end
  '
}

selected() {
  local target="$1" wanted
  if [[ ${#targets[@]} -gt 0 ]]; then
    for wanted in "${targets[@]}"; do
      [[ "$wanted" == "~/"* ]] && wanted="$HOME/${wanted#\~/}"
      [[ "$wanted" == "$target" ]] && return 0
    done
    return 1
  fi
  if [[ "$skip_agents" == 1 ]]; then
    case "$target" in "$HOME/.claude/"*|"$HOME/.codex/"*) return 1 ;; esac
  fi
  return 0
}

if [[ "$mode" == status ]]; then
  exec "$repo_root/bin/repo-mise" dot status --missing ${targets[@]+"${targets[@]}"}
fi
if [[ "$mode" == diff ]]; then
  # A diff of merged settings shows the lines around each key, and those can
  # hold tokens. Show the merge targets by name only.
  diff_targets=()
  rows="$(read_status)"
  while IFS=$'\t' read -r state entry_mode target; do
    [[ -n "${target:-}" && "$state" != applied ]] || continue
    selected "$target" || continue
    if [[ "$entry_mode" == merge ]]; then
      printf '%s: merged keys differ; content omitted\n' "$(home_name "$target")"
    else
      diff_targets+=("$target")
    fi
  done <<< "$rows"
  [[ ${#diff_targets[@]} -eq 0 ]] || repo_mise dot diff "${diff_targets[@]}"
  exit
fi

dry_run=0
if [[ "$mode" == apply ]]; then
  # Setup runs stages at the same time. The lock keeps link runs apart.
  . "$repo_root/bin/lib/setup-runtime.sh"
  runtime_init link-dotfiles
  trap 'runtime_on_exit "$?"' EXIT
  runtime_acquire_lock link-dotfiles 'dotfile linking' || exit 1
else
  dry_run=1
fi

# Prints the real path of the nearest folder above PATH that exists.
real_parent() {
  local folder
  folder="$(dirname "$1")"
  while [[ ! -d "$folder" ]]; do folder="$(dirname "$folder")"; done
  (cd "$folder" && pwd -P)
}
home_real="$(cd "$HOME" && pwd -P)"
repo_real="$(cd "$repo_root" && pwd -P)"

status_rows="$(read_status)"
if [[ ${#targets[@]} -gt 0 ]]; then
  # A target that matches no entry would make the run a silent no-op.
  for wanted in "${targets[@]}"; do
    [[ "$wanted" == "~/"* ]] && wanted="$HOME/${wanted#\~/}"
    found=0
    while IFS=$'\t' read -r _ _ target; do
      [[ "$target" != "$wanted" ]] || { found=1; break; }
    done <<< "$status_rows"
    [[ "$found" == 1 ]] || {
      printf 'link-dotfiles: no entry manages %s. Give the full HOME path of an entry.\n' "$wanted" >&2
      exit 2
    }
  done
fi
file_targets=()
merge_targets=()
template_targets=()
changing_rows=()
while IFS=$'\t' read -r state entry_mode target; do
  [[ -n "${target:-}" ]] || continue
  selected "$target" || continue
  if [[ "$target" == "$HOME/.config/nvim" ]] && [[ -z "$(ls -A "$repo_root/nvim" 2>/dev/null)" ]]; then
    printf 'Skipped ~/.config/nvim: the nvim submodule is empty. Run git submodule update --init nvim.\n'
    continue
  fi
  # A folder link on the way to a target must not lead into this repository
  # or out of HOME, because mise would write the file there.
  parent="$(real_parent "$target")"
  if [[ "$parent/" != "$home_real/"* || "$parent/" == "$repo_real/"* ]]; then
    printf 'link-dotfiles: the folder of %s resolves to %s. Fix that folder link, then rerun.\n' \
      "$(home_name "$target")" "$parent" >&2
    exit 1
  fi
  if [[ "$entry_mode" == merge ]]; then
    if [[ -L "$target" ]]; then
      # The agents write private paths into their settings. A link would put
      # them in a tracked file.
      printf 'link-dotfiles: %s is a link. Replace it with a regular file, then rerun.\n' "$(home_name "$target")" >&2
      exit 1
    fi
    merge_targets+=("$target")
  else
    file_targets+=("$target")
    [[ "$entry_mode" != template ]] || template_targets+=("$target")
  fi
  [[ "$state" == applied ]] || changing_rows+=("$entry_mode"$'\t'"$target")
done <<< "$status_rows"

# Before ~/.config/mise/config.toml is linked, mise's preview of that link
# warns that the missing file is not trusted. The real apply does not warn.
drop_first_link_warning() {
  awk '/failed to parse config source .* are not trusted/ { skip = 1; next }
    skip && /^Trust them with/ { skip = 0; next }
    { skip = 0; print }'
}

# Check the whole selection before the first change. A merge error or a
# template error can quote a settings file, so those checks print nothing.
if [[ ${#file_targets[@]} -gt 0 ]]; then
  if [[ "$dry_run" == 1 ]]; then
    # --force previews the result after the backups remove the conflicts.
    repo_mise dot apply --dry-run --force --yes "${file_targets[@]}" 2> >(drop_first_link_warning >&2)
  elif ! repo_mise dot apply --dry-run --force --yes "${file_targets[@]}" >/dev/null 2> >(drop_first_link_warning >&2); then
    printf 'link-dotfiles: mise cannot apply the selection. Nothing changed.\n' >&2
    exit 1
  fi
fi
if [[ ${#merge_targets[@]} -gt 0 ]] && ! repo_mise dot apply --dry-run --yes "${merge_targets[@]}" >/dev/null 2>&1; then
  printf 'link-dotfiles: mise cannot merge into %s. Check that they are valid JSON or TOML. Nothing changed.\n' \
    "${merge_targets[*]}" >&2
  exit 1
fi
# A dry run lists templates without rendering them. A diff renders them.
if [[ ${#template_targets[@]} -gt 0 ]] && ! repo_mise dot diff "${template_targets[@]}" >/dev/null 2>&1; then
  printf 'link-dotfiles: a template does not render: %s. Nothing changed.\n' "${template_targets[*]}" >&2
  exit 1
fi

# Local files from the old layout move to their new place. Git ignores both.
move_local() {
  local from="$1" to="$2"
  [[ -e "$from" || -L "$from" ]] || return 0
  if [[ -e "$to" || -L "$to" ]]; then
    printf 'Left %s in place: %s exists. Merge them by hand.\n' "${from#"$repo_root"/}" "${to#"$repo_root"/}" >&2
    return 0
  fi
  if [[ "$dry_run" == 1 ]]; then
    printf 'Would move %s to %s\n' "${from#"$repo_root"/}" "${to#"$repo_root"/}"
    return 0
  fi
  mkdir -p "$(dirname "$to")"
  mv "$from" "$to"
  printf 'Moved %s to %s\n' "${from#"$repo_root"/}" "${to#"$repo_root"/}"
}
move_old_local_files() {
  local file
  move_local "$repo_root/mise/setup/miserc.local.toml" "$repo_root/.miserc.local.toml"
  for file in "$repo_root"/home/.config/local/* "$repo_root"/home/.config/local/.[!.]*; do
    [[ -e "$file" && "$file" != *.example ]] || continue
    move_local "$file" "$repo_root/local/${file##*/}"
  done
}

# Links that older versions of this repository made. Remove each one only
# while it still points into this repository.
retired_links=(
  "$HOME/.config/telemetry/env.sh"
  "$HOME/.config/mise/locks"
  "$HOME/.config/mise/tasks/backup"
  "$HOME/.config/mise/tasks/doctor"
  "$HOME/.config/mise/tasks/packages"
  "$HOME/.config/mise/tasks/restore"
  "$HOME/.config/mise/tasks/setup"
  "$HOME/.config/mise/tasks/update"
  "$HOME/.config/mise/tasks/dot/apply"
  "$HOME/.config/mise/tasks/dot/diff"
  "$HOME/.config/mise/tasks/dot/status"
)

# The Mac steps outside HOME run only for the account's own home folder, so a
# run with a temporary HOME cannot repoint them.
account_home=1
if [[ "$(uname -s)" == Darwin ]]; then
  account_home_path="$(dscl . -read "/Users/$(id -un)" NFSHomeDirectory 2>/dev/null | awk '{print $2}')" || account_home_path=""
  [[ -n "$account_home_path" && "$(cd "$account_home_path" 2>/dev/null && pwd -P)" == "$home_real" ]] || account_home=0
fi

# Homebrew's CLIProxyAPI service reads $(brew --prefix)/etc/cliproxyapi.conf.
link_brew_config() {
  local config="$HOME/.cli-proxy-api/config.yaml" prefix brew_config
  prefix="$(brew --prefix 2>/dev/null)" && [[ -e "$config" ]] || return 0
  brew_config="$prefix/etc/cliproxyapi.conf"
  [[ ! -L "$brew_config" || "$(readlink "$brew_config")" != "$config" ]] || return 0
  if [[ "$dry_run" == 1 ]]; then
    printf 'Would link %s to %s\n' "$brew_config" "$(home_name "$config")"
    return 0
  fi
  if [[ -e "$brew_config" || -L "$brew_config" ]]; then
    save "$brew_config" "homebrew/etc/cliproxyapi.conf" move || {
      printf 'link-dotfiles: could not back up %s. It is unchanged.\n' "$brew_config" >&2
      return 1
    }
    rm -f "$brew_config" || return
  fi
  mkdir -p "$prefix/etc" || return
  ln -s "$config" "$brew_config"
}

if [[ "$dry_run" == 1 ]]; then
  move_old_local_files
  for link in "${retired_links[@]}"; do
    [[ -L "$link" && "$(readlink "$link")" == "$repo_root/"* ]] || continue
    printf 'Would remove the old link %s\n' "$(home_name "$link")"
  done
  for row in ${changing_rows[@]+"${changing_rows[@]}"}; do
    target="${row#*$'\t'}"
    [[ -e "$target" || -L "$target" ]] || continue
    printf 'Would back up %s\n' "$(home_name "$target")"
  done
  for row in ${changing_rows[@]+"${changing_rows[@]}"}; do
    [[ "${row%%$'\t'*}" == merge ]] || continue
    printf 'Would merge the keys from the repository into %s\n' "$(home_name "${row#*$'\t'}")"
  done
  [[ "$(uname -s)" == Darwin && ${#targets[@]} -eq 0 ]] || exit 0
  if [[ "$account_home" == 0 ]]; then
    printf 'Would skip the Homebrew and t3 links: HOME is not the home folder of this account.\n'
    exit 0
  fi
  link_brew_config
  "$repo_root/bin/link-t3-command" --dry-run || true
  exit 0
fi

backup_root=""
moved_targets=()
# Usage: save PATH NAME move|copy. NAME is the path inside the backup folder.
save() {
  local target="$1" name="$2" how="$3" destination
  if [[ -z "$backup_root" ]]; then
    # Backups hold private settings. They stay in a real folder in HOME.
    if [[ -L "$HOME/.dotfiles-backups" ]]; then
      printf 'link-dotfiles: ~/.dotfiles-backups is a link. Replace it with a folder.\n' >&2
      return 1
    fi
    mkdir -p "$HOME/.dotfiles-backups" || return
    chmod 700 "$HOME/.dotfiles-backups" || return
    backup_root="$(mktemp -d "$HOME/.dotfiles-backups/links-$(date +%Y%m%d-%H%M%S)-XXXXXX")" || return
    printf 'Backups: %s\n' "$backup_root"
  fi
  destination="$backup_root/$name"
  mkdir -p "$(dirname "$destination")" || return
  if [[ -L "$target" ]]; then
    # Keep the old link itself. mise points it at the new source.
    ln -s "$(readlink "$target")" "$destination" || return
  elif [[ "$how" == move ]]; then
    mv "$target" "$destination" || return
    moved_targets+=("$target")
  else
    cp -pR "$target" "$destination" || return
  fi
  printf 'Saved %s\n' "$target"
}

# Puts each moved file back after a failed apply. A link that mise made in
# its place goes first.
restore_moved() {
  local target
  for target in ${moved_targets[@]+"${moved_targets[@]}"}; do
    if [[ -L "$target" ]]; then
      rm "$target"
    elif [[ -e "$target" ]]; then
      printf 'Kept %s. Its original is in %s.\n' "$(home_name "$target")" "$backup_root" >&2
      continue
    fi
    mv "$backup_root/${target#"$HOME"/}" "$target" &&
      printf 'Restored %s\n' "$(home_name "$target")" >&2
  done
}

# ~/.gitconfig.local keeps the identity when the old ~/.gitconfig gives way
# to the repository link. The tracked file includes ~/.gitconfig.local.
keep_git_identity() {
  local old="$HOME/.gitconfig" local_file="$HOME/.gitconfig.local" key value
  if [[ -L "$local_file" ]]; then
    printf 'link-dotfiles: ~/.gitconfig.local is a link. Replace it with a regular file.\n' >&2
    return 1
  fi
  for key in user.name user.email; do
    value="$(git config --file "$old" --get "$key" 2>/dev/null)" || continue
    [[ -n "$value" ]] || continue
    git config --file "$local_file" --get "$key" >/dev/null 2>&1 && continue
    if [[ ! -e "$local_file" ]]; then
      (umask 077 && : > "$local_file") || return
    fi
    git config --file "$local_file" "$key" "$value" || return
    printf 'Copied %s to ~/.gitconfig.local\n' "$key"
  done
}

# Nothing has moved yet, so a failure here needs no restore.
for row in ${changing_rows[@]+"${changing_rows[@]}"}; do
  [[ "${row#*$'\t'}" == "$HOME/.gitconfig" ]] || continue
  [[ -e "$HOME/.gitconfig" || -L "$HOME/.gitconfig" ]] || continue
  keep_git_identity || {
    printf 'link-dotfiles: could not copy the Git identity to ~/.gitconfig.local. Nothing changed.\n' >&2
    exit 1
  }
done
move_old_local_files

for row in ${changing_rows[@]+"${changing_rows[@]}"}; do
  entry_mode="${row%%$'\t'*}"
  target="${row#*$'\t'}"
  [[ -e "$target" || -L "$target" ]] || continue
  how=copy
  [[ "$entry_mode" != symlink || -L "$target" ]] || how=move
  if ! save "$target" "${target#"$HOME"/}" "$how"; then
    printf 'link-dotfiles: could not back up %s. Putting the moved files back.\n' "$(home_name "$target")" >&2
    restore_moved
    exit 1
  fi
done
for link in "${retired_links[@]}"; do
  [[ -L "$link" && "$(readlink "$link")" == "$repo_root/"* ]] || continue
  rm "$link"
  printf 'Removed the old link %s\n' "$(home_name "$link")"
done
rmdir "$HOME/.config/mise/tasks/dot" "$HOME/.config/mise/tasks" "$HOME/.config/telemetry" 2>/dev/null || true

if [[ ${#file_targets[@]} -gt 0 ]] && ! repo_mise dot apply --yes "${file_targets[@]}"; then
  printf 'link-dotfiles: mise stopped. Putting the moved files back.\n' >&2
  restore_moved
  exit 1
fi
if [[ ${#merge_targets[@]} -gt 0 ]]; then
  created=()
  for target in "${merge_targets[@]}"; do
    [[ ! -e "$target" ]] || continue
    # mise would create the file with mode 0644. Agent settings stay private.
    mkdir -p "$(dirname "$target")" || { printf 'link-dotfiles: could not create %s.\n' "$(home_name "$target")" >&2; exit 1; }
    case "$target" in
      *.json) (umask 077 && printf '{}\n' > "$target") ;;
      *) (umask 077 && : > "$target") ;;
    esac || { printf 'link-dotfiles: could not create %s.\n' "$(home_name "$target")" >&2; exit 1; }
    created+=("$target")
  done
  # A parse error from mise can quote a settings file, so its output stays
  # out of the terminal and the setup logs.
  if ! repo_mise dot apply --yes "${merge_targets[@]}" >/dev/null 2>&1; then
    # The files that this run created hold no settings yet.
    for target in ${created[@]+"${created[@]}"}; do rm -f "$target"; done
    printf 'link-dotfiles: mise could not merge the settings. Output omitted; it can contain private values.\n' >&2
    printf 'Check these files are valid JSON or TOML, then rerun: %s\n' "${merge_targets[*]}" >&2
    exit 1
  fi
  printf 'Merged settings in %s\n' "${merge_targets[*]}"
  # bin/save-settings saves only after this machine merged the current files.
  "$repo_root/bin/save-settings" --record "${merge_targets[@]}" ||
    printf 'Could not record the merge for bin/save-settings.\n' >&2
fi
# Trust the repository config, so mise commands in this folder load it.
for config in "$repo_root"/mise.toml "$repo_root"/mise.*.toml; do
  repo_mise trust "$config" >/dev/null 2>&1 || true
done

# The Mac links outside HOME and the t3 command link run on full applies only.
[[ "$(uname -s)" == Darwin && ${#targets[@]} -eq 0 ]] || exit 0
if [[ "$account_home" == 0 ]]; then
  printf 'Skipped the Homebrew and t3 links: HOME is not the home folder of this account.\n'
  exit 0
fi
# Setup can install Homebrew packages at the same time.
runtime_with_lock homebrew link_brew_config
"$repo_root/bin/link-t3-command" ||
  printf 'The t3 command was not linked. Run ./bin/link-t3-command after you fix the conflict.\n' >&2

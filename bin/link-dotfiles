#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mode=apply
telemetry_only=0
for argument in "$@"; do
  case "$argument" in
    --telemetry-only) telemetry_only=1 ;;
    --status|--diff|--dry-run)
      [[ "$mode" == apply ]] || { printf 'Choose one inspection mode.\n' >&2; exit 2; }
      mode="${argument#--}"
      ;;
    *) printf 'Usage: link-dotfiles [--telemetry-only] [--status | --diff | --dry-run]\n' >&2; exit 2 ;;
  esac
done

. "$repo_root/bin/lib/dotfiles-profile.sh"
DOTFILES_PROFILE="$(dotfiles_profile "$repo_root")" || exit
export DOTFILES_PROFILE

# Check the profile before the runtime creates logs or takes locks. Native
# diagnostics can contain private settings, so do not forward their text.
if ! "$repo_root/bin/repo-mise" --setup dot status --json >/dev/null 2>&1; then
  printf 'Cannot read setup. Check the selected profile, the mise pin, and the private configuration.\n' >&2
  exit 1
fi

if [[ "$mode" != apply ]]; then
  exec /usr/bin/ruby "$repo_root/bin/lib/dotfiles-native.rb" "$repo_root" "$mode" "$telemetry_only"
fi

. "$repo_root/bin/lib/setup-runtime.sh"
runtime_init link-dotfiles
trap 'runtime_on_exit "$?"' EXIT
runtime_acquire_lock link-dotfiles 'dotfile linking' || exit 1
if [[ "$(uname -s)" == Darwin && "$telemetry_only" == 0 ]]; then
  runtime_with_lock homebrew /usr/bin/ruby "$repo_root/bin/lib/dotfiles-native.rb" "$repo_root" "$mode" "$telemetry_only"
else
  /usr/bin/ruby "$repo_root/bin/lib/dotfiles-native.rb" "$repo_root" "$mode" "$telemetry_only"
fi

#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
timestamp="$(date +%Y%m%d-%H%M%S)"
backup_root="${HOME}/.dotfiles-backups/${timestamp}"
created_backup_root=0
telemetry_only=0
status_only=0
agent_settings_status=0
for argument in "$@"; do
  case "$argument" in
    --telemetry-only) telemetry_only=1 ;;
    --status) status_only=1 ;;
    *) printf 'Usage: link-dotfiles [--telemetry-only | --status]\n' >&2; exit 2 ;;
  esac
done

# Read-only drift report from the [dotfiles] list in mise/setup.toml.
if [[ "$status_only" == 1 ]]; then
  status_json="$("${repo_root}/bin/repo-mise" "${repo_root}/mise/setup.toml" dot status --json)" || exit
  /usr/bin/ruby -rjson -e '
    status = JSON.parse(STDIN.read)
    entries = status.fetch("files").map { |file| [file["state"], file["target"]] } +
      status.fetch("edits").map { |edit| [edit["state"], "#{edit["path"]} (#{edit["edit"]})"] }
    drift = entries.reject { |state, _| state == "applied" }
    drift.each { |state, target| printf("%-15s %s\n", state, target) }
    printf("%d of %d managed files and merges are in place.\n", entries.size - drift.size, entries.size)
    exit(drift.empty? ? 0 : 1)
  ' <<< "$status_json"
  exit
fi

# shellcheck source=bin/lib/setup-runtime.sh
. "${repo_root}/bin/lib/setup-runtime.sh"
. "${repo_root}/bin/lib/mise-pin.sh"
runtime_init "link-dotfiles"

cleanup() {
  runtime_on_exit "$?"
}

trap cleanup EXIT
runtime_acquire_lock "link-dotfiles" "dotfile linking" || exit 1

managed_sources=(
  "${repo_root}/home/.zshenv"
  "${repo_root}/home/.zprofile"
  "${repo_root}/home/.zshrc"
  "${repo_root}/home/.p10k.zsh"
  "${repo_root}/home/.mackup.cfg"
  "${repo_root}/home/.gitconfig"
  "${repo_root}/home/bin/harness"
  "${repo_root}/home/bin/gh"
  "${repo_root}/home/bin/dotfiles-gh-real"
  "${repo_root}/home/bin/dotfiles-telemetry-env"
  "${repo_root}/home/.rgrc"
  "${repo_root}/home/.tmux.conf"
  "${repo_root}/home/.cli-proxy-api/config.yaml"
  "${repo_root}/home/.config/mise/config.toml"
  "${repo_root}/home/.config/telemetry/env.sh"
  "${repo_root}/home/.config/zsh/env.zsh"
  "${repo_root}/home/.config/zsh/profile.zsh"
  "${repo_root}/home/.config/zsh/interactive.zsh"
  "${repo_root}/home/.config/zsh/path.zsh"
  "${repo_root}/home/.config/zsh/aliases.zsh"
  "${repo_root}/home/.config/zsh/harness.zsh"
  "${repo_root}/home/.config/zsh/mise-npx.zsh"
  "${repo_root}/home/.config/zsh/functions.zsh"
  "${repo_root}/home/.config/zsh/check-updates.zsh"
  "${repo_root}/home/.config/karabiner/karabiner.json"
  "${repo_root}/home/Documents/superwhisper/settings/settings.json"
  "${repo_root}/home/scripts/toggle_function_keys.sh"
)

managed_app_sources=(
  "AeroSpace|${repo_root}/home/.aerospace.toml"
  "Ghostty|${repo_root}/home/Library/Application Support/com.mitchellh.ghostty/config"
)

if [[ "$telemetry_only" == 1 ]]; then
  managed_sources=("${repo_root}/home/.config/telemetry/env.sh"
    "${repo_root}/home/bin/dotfiles-telemetry-env")
  managed_app_sources=()
elif [[ -d "${repo_root}/nvim" ]] && find "${repo_root}/nvim" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
  managed_sources+=("${repo_root}/nvim")
else
  printf 'Skipping nvim link; submodule is not initialized\n'
fi

backup_target() {
  local target="$1"
  local relative_target backup_path

  [[ ${created_backup_root} -eq 1 ]] || {
    mkdir -p "${backup_root}"
    created_backup_root=1
  }

  if [[ "${target}" == "${HOME}/"* ]]; then
    relative_target="${target#${HOME}/}"
  else
    relative_target="root/${target#/}"
  fi
  backup_path="${backup_root}/${relative_target}"
  mkdir -p "$(dirname "${backup_path}")"
  mv "${target}" "${backup_path}"
  printf 'Backed up %s -> %s\n' "${target}" "${backup_path}"
}

# Keep a private copy of a file that a merge is about to change.
backup_copy() {
  local target="$1" backup_path

  [[ ${created_backup_root} -eq 1 ]] || {
    mkdir -p "${backup_root}" || return
    created_backup_root=1
  }
  backup_path="${backup_root}/${target#${HOME}/}"
  mkdir -p "$(dirname "${backup_path}")" || return
  (umask 077 && cp "${target}" "${backup_path}") || return
  printf 'Backed up %s -> %s\n' "${target}" "${backup_path}"
}

# Claude Code and Codex rewrite their settings, so the repo owns only some keys.
# mise merges those keys from mise/setup.toml and keeps every other key.
merge_agent_settings() {
  local config="${repo_root}/mise/setup.toml" status_json changing_list target
  local targets=("${HOME}/.claude/settings.json" "${HOME}/.codex/config.toml")
  local created=() changing=()

  if ! mise_at_pin "${MISE_INSTALL_PATH:-${HOME}/.local/bin/mise}"; then
    printf '!! Agent settings were not merged; run ./bin/ensure-mise-standalone, then ./bin/link-dotfiles\n' >&2
    return 1
  fi
  if [[ -n "${CODEX_HOME:-}" && "${CODEX_HOME%/}" != "${HOME}/.codex" ]]; then
    printf '!! CODEX_HOME is set, but the Codex settings merge uses ~/.codex/config.toml\n' >&2
  fi
  # mise would create a missing file with the umask mode. These stay private.
  for target in "${targets[@]}"; do
    [[ -e "$target" || -L "$target" ]] && continue
    mkdir -p "$(dirname "$target")" || return
    case "$target" in
      *.json) (umask 077 && printf '{}\n' > "$target") || return ;;
      *) (umask 077 && : > "$target") || return ;;
    esac
    created+=("$target")
  done
  status_json="$("${repo_root}/bin/repo-mise" "$config" dot status --json)" || return
  # Stop before any write when the status cannot decide which files need a backup.
  changing_list="$(/usr/bin/ruby -rjson -e '
    JSON.parse(STDIN.read).fetch("edits").each do |edit|
      next if edit["state"] == "applied"
      abort "unknown merge state #{edit["state"]}" unless %w[missing differs].include?(edit["state"])
      puts File.expand_path(edit["path"])
    end
  ' <<< "$status_json")" || return
  while IFS= read -r target; do
    [[ -n "$target" ]] && changing+=("$target")
  done <<< "$changing_list"
  for target in ${changing[@]+"${changing[@]}"}; do
    case " ${created[*]-} " in *" ${target} "*) continue ;; esac
    backup_copy "$target" || return
  done
  # A TOML parse error from mise quotes the file, which can hold secrets. Logs
  # must not get it.
  if ! "${repo_root}/bin/repo-mise" "$config" dot apply --yes '~/.claude/settings.json' '~/.codex/config.toml' 2>/dev/null; then
    printf '!! Agent settings were not merged. Check that ~/.claude/settings.json is valid JSON, ~/.codex/config.toml is valid TOML, and neither is a symlink.\n' >&2
    return 1
  fi
}

link_cliproxyapi_homebrew_config() {
  local home_config="${HOME}/.cli-proxy-api/config.yaml"
  local brew_prefix brew_config

  if ! command -v brew >/dev/null 2>&1; then
    printf 'Skipping CLIProxyAPI Homebrew config link; Homebrew is not installed\n'
    return 0
  fi

  brew_prefix="$(brew --prefix)"
  brew_config="${brew_prefix}/etc/cliproxyapi.conf"

  if [[ ! -e "${home_config}" ]]; then
    printf 'Skipping CLIProxyAPI Homebrew config link; %s is missing\n' "${home_config}"
    return 0
  fi

  if [[ -L "${brew_config}" && "$(readlink "${brew_config}")" == "${home_config}" ]]; then
    printf 'Already linked %s\n' "${brew_config}"
    return 0
  fi

  mkdir -p "$(dirname "${brew_config}")"
  if [[ -e "${brew_config}" || -L "${brew_config}" ]]; then
    backup_target "${brew_config}"
  fi

  ln -s "${home_config}" "${brew_config}"
  printf 'Linked %s -> %s\n' "${brew_config}" "${home_config}"
}

preserve_git_identity() {
  local target="$1"
  local local_config="${HOME}/.gitconfig.local"
  local name email

  [[ "$target" == "${HOME}/.gitconfig" ]] || return 0
  [[ -e "$target" || -L "$target" ]] || return 0

  name="$(git config --file "$target" --get user.name 2>/dev/null || true)"
  email="$(git config --file "$target" --get user.email 2>/dev/null || true)"

  if [[ -n "$name" && -z "$(git config --file "$local_config" --get user.name 2>/dev/null || true)" ]]; then
    git config --file "$local_config" user.name "$name"
    chmod 600 "$local_config"
    printf 'Preserved Git user.name in %s\n' "$local_config"
  fi

  if [[ -n "$email" && -z "$(git config --file "$local_config" --get user.email 2>/dev/null || true)" ]]; then
    git config --file "$local_config" user.email "$email"
    chmod 600 "$local_config"
    printf 'Preserved Git user.email in %s\n' "$local_config"
  fi
}

link_path() {
  local source="$1"
  local target

  if [[ "$#" -ge 2 ]]; then
    target="$2"
  else
    target="${HOME}/${source#${repo_root}/home/}"
  fi

  if [[ "${source}" == "${repo_root}/nvim" ]]; then
    target="${HOME}/.config/nvim"
  fi

  mkdir -p "$(dirname "${target}")"

  if [[ -L "${target}" && "$(readlink "${target}")" == "${source}" ]]; then
    printf 'Already linked %s\n' "${target}"
    return 0
  fi

  if [[ -e "${target}" || -L "${target}" ]]; then
    preserve_git_identity "${target}"
    backup_target "${target}"
  fi

  ln -s "${source}" "${target}"
  printf 'Linked %s -> %s\n' "${target}" "${source}"
}

# Copy, not link: configure-telemetry compares the copy to reload a changed job.
copy_path() {
  local source="$1"
  local target="${HOME}/${source#${repo_root}/home/}"

  mkdir -p "$(dirname "${target}")"
  if [[ -f "${target}" && ! -L "${target}" ]] && cmp -s "${source}" "${target}"; then
    printf 'Already installed %s\n' "${target}"
    return 0
  fi

  if [[ -L "${target}" && "$(readlink "${target}")" == "${source}" ]]; then
    # An earlier link to the same source holds no user state.
    rm "${target}"
  elif [[ -e "${target}" || -L "${target}" ]]; then
    backup_target "${target}"
  fi

  cp "${source}" "${target}"
  printf 'Installed %s\n' "${target}"
}

append_installed_app_sources() {
  local entry app_bundle source

  for entry in "${managed_app_sources[@]}"; do
    app_bundle="${entry%%|*}"
    source="${entry#*|}"

    if [[ -d "${DOTFILES_APPLICATIONS_DIR:-/Applications}/${app_bundle}.app" ]]; then
      managed_sources+=("${source}")
    else
      printf 'Skipping %s config link; %s/%s.app is not installed\n' "${app_bundle}" "${DOTFILES_APPLICATIONS_DIR:-/Applications}" "${app_bundle}"
    fi
  done
}

if [[ "$telemetry_only" == 0 ]]; then
  append_installed_app_sources
fi

for source in "${managed_sources[@]}"; do
  if [[ ! -e "${source}" && ! -L "${source}" ]]; then
    printf 'Skipping missing source %s\n' "${source}"
    continue
  fi

  link_path "${source}"
done

if [[ "$telemetry_only" == 1 ]]; then
  copy_path "${repo_root}/home/Library/LaunchAgents/com.dotfiles.telemetry-env.plist"
fi

# mise before 2026.10.11 can drop the pipx dependency graphs in the lockfile.
link_mise_lock() {
  local lock="${repo_root}/home/.config/mise/mise.lock" target="${HOME}/.config/mise/mise.lock"
  if ! mise_at_pin "${MISE_INSTALL_PATH:-${HOME}/.local/bin/mise}"; then
    printf 'Skipping mise.lock link; run ./bin/ensure-mise-standalone, then ./bin/link-dotfiles\n'
    return 0
  fi
  if [[ -L "$target" && "$(readlink "$target")" == "$lock" ]]; then
    printf 'Already linked %s\n' "$target"
    return 0
  fi
  link_path "$lock"
  printf 'Run mise install to install the locked tool versions.\n'
}

if [[ "$telemetry_only" == 0 ]]; then
  link_mise_lock
fi

if [[ "$telemetry_only" == 0 && "${DOTFILES_LINK_AGENT_CONFIG:-1}" == 1 ]]; then
  agent_instructions="${repo_root}/home/.codex/AGENTS.md"
  link_path "$agent_instructions" "${HOME}/.codex/AGENTS.md"
  link_path "$agent_instructions" "${HOME}/.claude/CLAUDE.md"
  merge_agent_settings || agent_settings_status=1
fi

if [[ "$telemetry_only" == 0 ]]; then
  runtime_with_lock homebrew link_cliproxyapi_homebrew_config
  # A t3 conflict must not block the package stages that need these links.
  bash "${repo_root}/bin/link-t3-command" ||
    printf '!! t3 command not linked; run ./bin/link-t3-command after you resolve the conflict\n' >&2
fi

exit "$agent_settings_status"

#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
timestamp="$(date +%Y%m%d-%H%M%S)"
backup_dir="${repo_root}/.sync-backups/${timestamp}"
temp_brewfile="$(mktemp)"

cleanup() {
  rm -f "$temp_brewfile"
}

trap cleanup EXIT

log() {
  printf '==> %s\n' "$1"
}

mkdir -p "$backup_dir"
. "${repo_root}/bin/lib/dotfiles-profile.sh"
DOTFILES_PROFILE="$(dotfiles_profile "$repo_root")" || exit
# The Brewfile for every Mac, the profile's own Brewfile, and the mobile one.
brewfiles=()
while IFS= read -r brewfile; do brewfiles+=("$brewfile"); done < <(dotfiles_profile_app_lists "$repo_root" "$DOTFILES_PROFILE" brewfile)
brewfiles+=("${repo_root}/apps/mobile.Brewfile")

# Compares the entries of the Brewfiles (all but the last file) with the dump
# of the installed state (the last file). Order and comments do not count.
# Formulae and casks match by short name, so "borders" matches
# "felixkratz/formulae/borders". App Store apps match by id.
compare_brewfiles() {
  awk -v installed_file="${!#}" '
    function entry_key(name, id) {
      if (!match($0, /"[^"]*"/)) return ""
      name = substr($0, RSTART + 1, RLENGTH - 2)
      if ($1 == "mas" && match($0, /id: *[0-9]+/)) {
        id = substr($0, RSTART, RLENGTH)
        sub(/id: */, "", id)
        return "mas " id
      }
      if ($1 == "brew" || $1 == "cask") sub(/.*\//, "", name)
      return $1 " " tolower(name)
    }
    $1 !~ /^(tap|brew|cask|mas|vscode)$/ { next }
    { key = entry_key() }
    key == "" { next }
    FILENAME != installed_file { listed[key] = $0; next }
    { installed[key] = 1; if (!(key in listed)) print "+ " $0 }
    END { for (key in listed) if (!(key in installed)) print "- " listed[key] }
  ' "$@" | sort
}

if command -v brew >/dev/null 2>&1; then
  log "Capturing current Homebrew bundle to a temp file"
  brew bundle dump --file "$temp_brewfile" --force
  cp "${brewfiles[@]}" "$backup_dir/"
  drift="$(compare_brewfiles "${brewfiles[@]}" "$temp_brewfile")"
  if [[ -z "$drift" ]]; then
    log "Installed Homebrew entries match the Brewfiles of the ${DOTFILES_PROFILE} profile"
  else
    log "Homebrew drift (+ installed, not in a Brewfile; - in a Brewfile, not installed)"
    printf '%s\n' "$drift"
  fi
else
  log "Homebrew is not available; skipping the Brewfile comparison"
fi

if command -v mise >/dev/null 2>&1; then
  log "Current mise tool state"
  "$repo_root/bin/repo-mise" --global current || true
else
  log "mise is not available; skipping mise current"
fi

cat <<EOF

prepare-sync complete.
Backups are in: ${backup_dir}

This script only reports drift. Update tracked files intentionally, then run validation.
EOF

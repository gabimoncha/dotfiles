#!/usr/bin/env bash
# Apply documented local preferences to installed tools. Never install a tool.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for argument in "$@"; do
  case "$argument" in
    --dry-run) export DOTFILES_RUN_MODE=dry-run ;;
    -h|--help) printf 'Usage: configure-telemetry [--dry-run]\n'; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$argument" >&2; exit 2 ;;
  esac
done
. "$repo_root/bin/lib/setup-runtime.sh"
. "$repo_root/bin/lib/standalone.sh"
runtime_init configure-telemetry
trap 'runtime_on_exit "$?"' EXIT
runtime_acquire_lock telemetry 'telemetry configuration' || exit 1

telemetry_tool() {
  local name="$1" candidate=""
  if [[ -x "$HOME/.local/bin/mise" ]]; then
    candidate="$(MISE_AUTO_INSTALL=0 MISE_OFFLINE=1 standalone_probe "$repo_root/bin/repo-mise" --global which "$name" 2>/dev/null)" || candidate=""
  fi
  case "$candidate" in */shims/*) candidate="" ;; esac
  if [[ -n "$candidate" && -x "$candidate" ]]; then printf '%s\n' "$candidate"; return 0; fi
  candidate="$(command -v "$name" 2>/dev/null)" || return 1
  case "$candidate" in /*/shims/*) return 1 ;; esac
  [[ "$candidate" == /* && -x "$candidate" ]] || return 1
  printf '%s\n' "$candidate"
}

status=0
telemetry_command() {
  local name="$1" executable result=0
  shift
  executable="$(telemetry_tool "$name")" || return 0
  if [[ "$DOTFILES_RUN_MODE" == dry-run ]]; then
    printf 'Would configure telemetry: %s' "$name"; printf ' %q' "$@"; printf '\n'
    return 0
  fi
  standalone_probe "$executable" "$@" >/dev/null 2>&1 || result=$?
  if [[ "$result" != 0 ]]; then
    printf 'Could not configure %s telemetry (status %s). Rerun ./bin/configure-telemetry.\n' "$name" "$result" >&2
    status=1
  else printf 'Configured %s telemetry\n' "$name"; fi
}

# Cursor's files are JSON with comments, which mise cannot merge.
telemetry_file() {
  local name="$1" target="$2" source="$3"
  if [[ "$DOTFILES_RUN_MODE" == dry-run ]]; then
    printf 'Would configure %s telemetry in %s\n' "$name" "$target"
    return 0
  fi
  if /usr/bin/ruby "$repo_root/bin/lib/telemetry-config.rb" jsonc "$target" "$source"; then
    printf 'Configured %s telemetry\n' "$name"
  else
    printf 'Could not configure %s telemetry; existing settings were preserved.\n' "$name" >&2
    status=1
  fi
}

telemetry_backup_dir=""
# Usage: telemetry_backup FILE mv|cp. Keeps FILE in one private folder per run.
telemetry_backup() {
  if [[ -z "$telemetry_backup_dir" ]]; then
    if [[ -L "$HOME/.dotfiles-backups" ]]; then
      printf '~/.dotfiles-backups is a link. Replace it with a folder.\n' >&2
      return 1
    fi
    mkdir -p "$HOME/.dotfiles-backups" && chmod 700 "$HOME/.dotfiles-backups" &&
      telemetry_backup_dir="$(mktemp -d "$HOME/.dotfiles-backups/telemetry-$(date +%Y%m%d-%H%M%S)-XXXXXX")" || return
  fi
  case "$2" in
    mv) mv "$1" "$telemetry_backup_dir/" ;;
    *) cp -p "$1" "$telemetry_backup_dir/" ;;
  esac
}

telemetry_gui_environment() {
  local launchctl_path old_job="com.dotfiles.telemetry-env" result=0 account_home folder
  local agents="$HOME/Library/LaunchAgents"
  local old_plist="$agents/com.dotfiles.telemetry-env.plist" new_plist="$agents/dev.mise.telemetry-env.plist"
  # The job loads into the account's GUI session. A run with a temporary HOME
  # must not replace it.
  account_home="$(dscl . -read "/Users/$(id -un)" NFSHomeDirectory 2>/dev/null | awk '{print $2}')" || account_home=""
  if [[ -z "$account_home" || "$(cd "$account_home" 2>/dev/null && pwd -P)" != "$(cd "$HOME" && pwd -P)" ]]; then
    printf 'Skipped the telemetry login job: HOME is not the home folder of this account.\n'
    return 0
  fi
  # mise writes the job file, and it follows links. As for bin/link-dotfiles,
  # the folder must resolve inside HOME and outside this repository.
  folder="$agents"
  while [[ ! -d "$folder" ]]; do folder="$(dirname "$folder")"; done
  folder="$(cd "$folder" && pwd -P)"
  if [[ "$folder/" != "$(cd "$HOME" && pwd -P)/"* || "$folder/" == "$(cd "$repo_root" && pwd -P)/"* ||
    -L "$new_plist" || -L "$old_plist" ]]; then
    printf 'Could not install the telemetry login job: ~/Library/LaunchAgents must be a folder in HOME, and its job files must not be links.\n' >&2
    status=1
    return
  fi
  if [[ "$DOTFILES_RUN_MODE" == dry-run ]]; then
    printf 'Would install and load the telemetry environment login job\n'
    return 0
  fi
  # Apply only the files of the login script, with the usual backups.
  "$repo_root/bin/link-dotfiles" "$HOME/.config/zsh/telemetry.sh" "$HOME/bin/dotfiles-telemetry-env" ||
    { status=1; return; }
  # Setup copied its own job definition before mise managed the job.
  if [[ -f "$old_plist" ]]; then
    launchctl_path="$(telemetry_tool launchctl)" || { status=1; return; }
    telemetry_backup "$old_plist" mv ||
      { printf 'Could not back up the old login job %s.\n' "$old_job" >&2; status=1; return; }
    standalone_probe "$launchctl_path" bootout "gui/$UID/$old_job" >/dev/null 2>&1 || true
    printf 'Unloaded the old login job %s. Its file is in %s\n' "$old_job" "$telemetry_backup_dir"
  fi
  # mise replaces a job file that differs from its config. Keep a copy first.
  if [[ -f "$new_plist" ]] && ! "$repo_root/bin/repo-mise" bootstrap macos launchd-agents status --missing >/dev/null 2>&1; then
    telemetry_backup "$new_plist" cp ||
      { printf 'Could not back up the current login job file.\n' >&2; status=1; return; }
    printf 'Copied the current login job file to %s\n' "$telemetry_backup_dir"
  fi
  # The job runs at the next login. The script runs now for this session.
  standalone_probe "$HOME/bin/dotfiles-telemetry-env" || result=$?
  "$repo_root/bin/repo-mise" bootstrap macos launchd-agents apply --yes || result=$?
  if [[ "$result" != 0 ]]; then
    printf 'Could not load the telemetry environment login job; rerun in your macOS GUI session.\n' >&2
    status=1
  else printf 'Configured the GUI telemetry environment; reopen apps to use the new values.\n'; fi
}

# Claude Code and Codex read their opt-outs from their settings files.
# bin/link-dotfiles merges the keys of configs/claude/settings.json and
# configs/codex/config.toml into them.
telemetry_agent_settings() {
  local name settings
  for name in claude codex; do
    standalone_installed "$name" || continue
    case "$name" in
      claude) settings="$HOME/.claude/settings.json" ;;
      codex) settings="$HOME/.codex/config.toml" ;;
    esac
    if [[ "$DOTFILES_RUN_MODE" == dry-run ]]; then
      printf 'Would merge the %s telemetry settings into %s\n' "$name" "$settings"
      continue
    fi
    # One call for each agent, so a broken file of one does not block the other.
    if "$repo_root/bin/link-dotfiles" "$settings"; then
      printf 'Configured %s telemetry\n' "$name"
    else
      printf 'Could not merge the %s telemetry settings; rerun ./bin/link-dotfiles.\n' "$name" >&2
      status=1
    fi
  done
}

telemetry_agent_settings
telemetry_command brew analytics off
telemetry_command vercel telemetry disable
telemetry_command gcloud config set core/disable_usage_reporting true
telemetry_command eas analytics off
telemetry_command wrangler telemetry disable
telemetry_command flyctl settings analytics disable
telemetry_command turbo telemetry disable
if [[ -d "${DOTFILES_APPLICATIONS_DIR:-/Applications}/Cursor.app" ]]; then
  telemetry_file cursor "$HOME/Library/Application Support/Cursor/User/settings.json" "$repo_root/configs/cursor/telemetry-settings.json"
  telemetry_file cursor "$HOME/.cursor/argv.json" "$repo_root/configs/cursor/telemetry-argv.json"
fi
# The login job sets the GUI app environment, which exists only on macOS.
[[ "$(uname -s)" != Darwin ]] || telemetry_gui_environment
printf 'Manual settings and unavailable controls: see %s/apps/telemetry.md\n' "$repo_root"
exit "$status"

#!/usr/bin/env bash
# The run command of the t3 daemon in mise.container.toml, on a Linux host
# without systemd, such as the NAS container. It does what the unit from
# `t3 service install` does: it keeps T3's service launcher running. The
# launcher starts `t3 serve`, so the desktop app can update this server. An
# update gets a database backup, and a failed update goes back to the old version.
#
# pitchfork, through mise, starts this script, keeps one copy and its output,
# and stops it. The restart loop stays here: T3's unit restarts the launcher
# 5 seconds after every exit, and pitchfork restarts only after a failure, with
# a wait that grows with each restart.
set -eu
[[ "$(uname -s)" == Linux && "$(id -u)" != 0 ]] || {
  printf 'Run this supervisor as the non-root Linux development user.\n' >&2
  exit 1
}
umask 077
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"
# The daemon does not read the zsh files that load the telemetry opt-outs.
# T3 and its agents inherit them here.
[ ! -r "$HOME/.config/zsh/telemetry.sh" ] || . "$HOME/.config/zsh/telemetry.sh"
export T3CODE_HOME="$HOME/.t3" T3CODE_HOST=0.0.0.0 T3CODE_PORT=3773
# `t3 serve` uses the working directory for provider sessions.
cd /workspace
service_state="$T3CODE_HOME/runtime/service-state.json"

log() { printf 't3-supervise: %s\n' "$1"; }

# The protocol that `t3 service install` writes for the installed CLI. The CLI
# does not print it. When a T3 error names a new protocol, change this number.
launcher_protocol=4

# The launcher runs the version in service-state.json, and that server must
# speak the launcher's protocol. The container has no `t3 service install`, so do
# its work here: pin the runtime that the official installer linked as
# ~/.local/bin/t3 when the file is missing or pins an older version. Keep a
# newer version, which an update from the T3 app installed.
seed_service_state() {
  local runtime version active
  runtime="$(readlink -f "$HOME/.local/bin/t3")" || return 1
  version="$(basename "$(dirname "$runtime")")"
  [[ "$(cat "$(dirname "$runtime")/.install-complete" 2>/dev/null)" == "$version" ]] || return 1
  if [[ -f "$service_state" ]]; then
    active="$(sed -n 's/^ *"activeVersion": *"\([^"]*\)".*/\1/p' "$service_state")"
    [[ -n "$active" ]] || return 0
    [[ "$(printf '%s\n%s\n' "$active" "$version" | sort -V | tail -n 1)" != "$active" ]] || return 0
    cp -f "$service_state" "$service_state.bak"
  fi
  mkdir -p "$(dirname "$service_state")"
  printf '{\n  "protocol": %s,\n  "activeVersion": "%s"\n}\n' "$launcher_protocol" "$version" >"$service_state.tmp"
  mv -f "$service_state.tmp" "$service_state"
  log "pinned t3@$version (protocol $launcher_protocol) in $service_state"
}

pid=""
# Background sleeps let the trap run at once instead of after the sleep ends.
pause() {
  sleep "$1" &
  wait $! || true
}
# The launcher stops the server first. 90 seconds matches T3's launchd job.
# pitchfork waits for this script, so the launcher gets that time. The
# launcher runs in its own process group, so it gets only this SIGTERM.
stop_launcher() {
  kill -TERM "$pid" 2>/dev/null || return 0
  for _ in $(seq 90); do
    kill -0 "$pid" 2>/dev/null || return 0
    pause 1
  done
  kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
}
trap '[[ -z "$pid" ]] || stop_launcher; exit 0' TERM INT HUP

# Only one launcher may run. An earlier copy of this script can still run when
# pitchfork died and started again. SIGTERM lets its trap stop its launcher.
# pgrep is the only command in $(...), so no copy of this script runs it.
for old in $(pgrep -u "$(id -u)" -f -- '/bin/t3-dev-supervise$'); do
  [[ "$old" != "$$" ]] || continue
  kill -TERM "$old" 2>/dev/null || continue
  log "stopping an earlier supervisor (PID $old)"
  for _ in $(seq 95); do
    kill -0 "$old" 2>/dev/null || break
    pause 1
  done
  kill -KILL "$old" 2>/dev/null || true
done
# A launcher whose script was killed before its trap ran, for example by the
# out-of-memory killer, still runs in its own process group.
for pid in $(pgrep -u "$(id -u)" -f -- 't3 __service-launcher' || true); do
  log "stopping a launcher that an earlier supervisor left (PID $pid)"
  stop_launcher
done
pid=""

while true; do
  if seed_service_state; then
    # pitchfork stops a daemon with a signal to its whole process group. The
    # launcher handles only its first SIGTERM, and a second one would end its
    # cleanup. setsid gives it its own group, and stop_launcher signals it.
    setsid "$HOME/.local/bin/t3" __service-launcher &
    pid=$!
    wait "$pid" || log "launcher exited with status $?"
    pid=""
  else
    log "no complete runtime at ~/.local/bin/t3; rerun the T3 install script"
  fi
  pause 5
done

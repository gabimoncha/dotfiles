#!/usr/bin/env bash
# Connects this machine to tokenburnmarket and keeps its sync daemon current.
# mise installs the CLI. macOS and systemd hosts use the service that `daemon
# install` writes. A connected machine whose service file matches what `daemon
# install` would write now is left alone. A changed service file, for example
# after `mise up` moved node or the CLI, is written again without a new sign-in.
# A Linux host without systemd, such as the NAS container, runs the daemon as
# the tokenburnmarket daemon in mise.container.toml instead. Exit 20 means
# deferred: the step needs a terminal or a user session.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dry_run=0
case "${1:-}" in
  --dry-run) dry_run=1 ;;
  '') ;;
  *)
    echo 'Usage: setup-tokenburnmarket [--dry-run]' >&2
    exit 2
    ;;
esac
real_tool() {
  local path
  path="$(MISE_AUTO_INSTALL=0 "$repo_root/bin/repo-mise" --global which "$1" 2>/dev/null)" || return 1
  [[ -n "$path" && -x "$path" ]] || return 1
  printf '%s\n' "$path"
}

if ! cli="$(real_tool tokenburnmarket)" || ! node="$(real_tool node)"; then
  echo 'tokenburnmarket is not installed. Install the mise tools, then rerun setup.' >&2
  exit 20
fi
# The same node and script paths that the shebang and the mise shim give.
tbm() { (cd "$HOME" && "$node" "$cli" "$@"); }

mode=service
if [[ "$(uname -s)" == Darwin ]]; then
  service="$HOME/Library/LaunchAgents/com.tokenburnmarket.daemon.plist"
else
  service="$HOME/.config/systemd/user/tokenburnmarket.service"
  if ! systemctl --user show-environment >/dev/null 2>&1; then
    if [[ -d /run/systemd/system ]]; then
      echo 'systemd runs on this host, but this login has no systemd user session.' >&2
      echo "Log in on a console, or run: sudo loginctl enable-linger $(id -un). Then rerun this script." >&2
      exit 20
    fi
    mode=mise-daemon
  fi
fi

connected=1
# The check must not ask npm for a newer version. Only status asks, and
# `daemon install` would copy an exported switch into the service.
if TBM_NO_UPDATE_CHECK=1 tbm status | grep -q '^Not connected\.'; then connected=0; fi

connect_if_needed() {
  [[ "$connected" == 0 ]] || return 0
  if [[ ! -t 0 ]]; then
    echo 'tokenburnmarket sign-in needs a terminal. Rerun setup interactively, or run ./bin/setup-tokenburnmarket.' >&2
    exit 20
  fi
  echo 'Connecting this machine to tokenburnmarket. Approve the code in the browser.'
  tbm connect
}

if [[ "$mode" == mise-daemon ]]; then
  . "$repo_root/bin/lib/dotfiles-profile.sh"
  . "$repo_root/bin/lib/daemon-procs.sh"
  profile="$(dotfiles_profile "$repo_root")" || exit
  # The node and CLI that bin/tokenburnmarket-supervise starts: it runs
  # `mise which` in HOME, with the environment of the mise daemons.
  daemon_tool() {
    (
      daemon_env "$profile"
      cd "$HOME" && MISE_AUTO_INSTALL=0 exec "$HOME/.local/bin/mise" which "$1"
    ) 2>/dev/null
  }
  # pitchfork runs bin/tokenburnmarket-supervise as the mise daemon. Its PID,
  # when pitchfork reports it running and that process is the supervise loop.
  # status reads pitchfork's saved state, so check the process too.
  managed_pid() {
    local status pid
    status="$("$repo_root/bin/container-daemons" status tokenburnmarket 2>/dev/null)" || return 1
    printf '%s\n' "$status" | grep -qx 'Status: running' || return 1
    pid="$(printf '%s\n' "$status" | sed -n 's/^PID: *\([0-9][0-9]*\)$/\1/p')"
    [[ -n "$pid" ]] || return 1
    supervise_pid "$pid" tokenburnmarket-supervise || return 1
    printf '%s\n' "$pid"
  }
  daemon_pids() {
    matching_pids daemon tbm_daemon_pid
    [[ ${#matched[@]} == 0 ]] || printf '%s\n' "${matched[@]}"
  }
  parent_pid() { ps -o ppid= -p "$1" | tr -d ' '; }
  # Current: the managed loop started a daemon with the node and CLI that the
  # loop would start now.
  daemon_current() {
    local managed p arg want_node want_cli
    managed="$(managed_pid)" || return 1
    want_node="$(daemon_tool node)" && want_cli="$(daemon_tool tokenburnmarket)" || return 1
    for p in $(daemon_pids); do
      [[ "$(parent_pid "$p")" == "$managed" ]] || continue
      [[ "$(readlink -f "/proc/$p/exe")" == "$(readlink -f "$want_node")" ]] || continue
      proc_args "$p" || continue
      for arg in "${proc_args[@]}"; do
        [[ "$arg" != "$want_cli" ]] || return 0
      done
    done
    return 1
  }
  # The daemons that the managed loop did not start.
  unmanaged_pids() {
    local managed p
    managed="$(managed_pid)" || managed=""
    for p in $(daemon_pids); do
      [[ -n "$managed" && "$(parent_pid "$p")" == "$managed" ]] || printf '%s\n' "$p"
    done
  }
  # Before the mise daemon, setup installed the supervisor here and started it.
  old_supervisor="$HOME/.local/bin/tokenburnmarket-supervise"
  # The entrypoint of the container starts the daemons after a restart.
  boot_note() {
    tr '\0' ' ' </proc/1/cmdline 2>/dev/null | grep -q 'daemons start' && return 0
    echo 'The container does not start the mise daemons after a restart. In the compose'
    echo 'file on the host, replace the whole command block with the one in'
    echo 'local/nasbox.compose.yaml.example, and add stop_grace_period: 130s. Then rebuild'
    echo 'the project, and keep the volumes. A restart keeps the old command.'
  }
  # The CLI reads its sign-in from XDG_CONFIG_HOME when that is an absolute
  # path, and from ~/.config otherwise. pitchfork keeps the environment of the
  # command that started it, so the daemon can read another folder than setup.
  config_home_of() {
    local value
    value="$(tr '\0' '\n' <"/proc/$1/environ" 2>/dev/null | sed -n 's/^XDG_CONFIG_HOME=//p' | head -n 1)"
    [[ "$value" == /* ]] || value="$HOME/.config"
    printf '%s\n' "$value"
  }
  setup_config_home="${XDG_CONFIG_HOME:-}"
  [[ "$setup_config_home" == /* ]] || setup_config_home="$HOME/.config"
  # Exits with an error when the managed loop, and so its daemon, reads
  # another config folder than setup signed in with.
  check_config_home() {
    local managed daemon_home
    managed="$(managed_pid)" || return 0
    daemon_home="$(config_home_of "$managed")"
    [[ "$daemon_home" == "$setup_config_home" ]] && return 0
    printf 'The tokenburnmarket mise daemon reads its sign-in from %s, but setup used %s.\n' "$daemon_home" "$setup_config_home" >&2
    echo 'pitchfork keeps the environment of the command that started it. From a shell with the' >&2
    echo 'same XDG_CONFIG_HOME as setup, run "$(mise which pitchfork) supervisor stop", then' >&2
    echo './bin/container-daemons start --all.' >&2
    exit 1
  }

  if [[ "$connected" == 1 && ! -e "$old_supervisor" && -z "$(unmanaged_pids)" ]] && daemon_current; then
    check_config_home
    echo 'tokenburnmarket is connected and its mise daemon runs.'
    boot_note
    exit 0
  fi
  if [[ "$dry_run" == 1 ]]; then
    [[ "$connected" == 1 ]] || echo 'Would run tokenburnmarket connect (browser sign-in).'
    [[ ! -e "$old_supervisor" ]] || printf 'Would stop and remove the old supervisor %s\n' "$old_supervisor"
    [[ -z "$(unmanaged_pids)" ]] || echo 'Would stop the tokenburnmarket daemons that mise did not start.'
    echo 'Would restart the tokenburnmarket mise daemon.'
    exit 0
  fi

  connect_if_needed
  if [[ -e "$old_supervisor" ]]; then
    # The old supervisor stops its daemon when it gets SIGTERM.
    pkill -TERM -u "$(id -u)" -f "bash $old_supervisor\$" || true
    rm -f "$old_supervisor"
    printf 'Stopped and removed the old supervisor %s\n' "$old_supervisor"
  fi
  # Two daemons must not sync at once, so wait until these exit. Each check
  # reads the process again, so a zombie, or a new process that Linux gave
  # the PID to, counts as exited.
  for p in $(unmanaged_pids); do
    # The watchdog can start pitchfork again since the list was made. A
    # daemon that the managed loop now runs stays.
    tbm_daemon_pid "$p" || continue
    if managed="$(managed_pid)" && [[ "$(parent_pid "$p")" == "$managed" ]]; then continue; fi
    kill -TERM "$p" 2>/dev/null || true
    for _ in $(seq 20); do
      tbm_daemon_pid "$p" || break
      sleep 0.5
    done
    if tbm_daemon_pid "$p"; then kill -KILL "$p" 2>/dev/null || true; fi
    for _ in 1 2 3 4; do
      tbm_daemon_pid "$p" || break
      sleep 0.5
    done
    if tbm_daemon_pid "$p"; then
      printf 'tokenburnmarket daemon %s still runs after SIGKILL. Not restarting the mise daemon.\n' "$p" >&2
      exit 1
    fi
    printf 'Stopped a tokenburnmarket daemon that mise did not start (PID %s)\n' "$p"
  done
  # A restart also starts a stopped daemon, and replaces one that runs an old
  # node or CLI.
  "$repo_root/bin/container-daemons" restart tokenburnmarket
  check_config_home
  boot_note
  exit 0
fi

# The definition between "Save this as PATH" and "Then load it:" or "Then enable it:".
expected_service() {
  tbm daemon install --dry-run | awk '
    NR <= 2 { next }
    /^Then (load|enable) it:$/ { exit }
    { lines[++n] = $0 }
    END { for (i = 1; i < n; i++) print lines[i] }'
}

current=''
[[ ! -f "$service" ]] || current="$(cat "$service")"
expected="$(expected_service)"
[[ -n "$expected" ]] || {
  echo 'Could not read the service definition from tokenburnmarket.' >&2
  exit 1
}

# Keep a service that runs another install of the CLI, such as a bun or npm
# global, while that install exists. A removed install gets the mise service.
foreign_service() {
  local path found=0
  [[ "$current" != *"/mise/installs/npm-tokenburnmarket/"* ]] || return 1
  while IFS= read -r path; do
    case "$path" in *.log) continue ;; esac
    [[ -e "$path" ]] || return 1
    found=1
  done < <(printf '%s\n' "$current" | grep -o '/[^<>" ]*tokenburnmarket[^<>" ]*' || true)
  [[ "$found" == 1 ]]
}
if [[ -n "$current" && "$current" != "$expected" ]] && foreign_service; then
  printf 'Kept the tokenburnmarket service from another install: %s\n' "$service"
  printf 'To move it to the mise install, remove the other install, then rerun this script.\n'
  current="$expected"
fi
if [[ "$connected" == 1 && "$current" == "$expected" ]]; then
  printf 'tokenburnmarket is connected and its daemon is installed: %s\n' "$service"
  exit 0
fi

if [[ "$dry_run" == 1 ]]; then
  [[ "$connected" == 1 ]] || echo 'Would run tokenburnmarket connect (browser sign-in).'
  if [[ -z "$current" ]]; then
    printf 'Would install the daemon service: %s\n' "$service"
  elif [[ "$current" != "$expected" ]]; then
    printf 'Would rewrite the daemon service, which differs from the current definition: %s\n' "$service"
  fi
  exit 0
fi

connect_if_needed
if [[ "$current" != "$expected" ]]; then
  tbm daemon install
fi

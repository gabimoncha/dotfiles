#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "${repo_root}/bin/lib/setup-runtime.sh"
for runtime_argument in "$@"; do
  [[ "$runtime_argument" != --dry-run ]] || DOTFILES_RUN_MODE=dry-run
done
unset runtime_argument
runtime_init "ensure-codex-standalone"
dry_run=0
codex_home="${CODEX_HOME:-${HOME}/.codex}"
install_dir="${CODEX_INSTALL_DIR:-${HOME}/.local/bin}"
standalone_bin="${codex_home}/packages/standalone/current/bin/codex"
visible_bin="${install_dir}/codex"

log() {
  printf '==> %s\n' "$1"
}

warn() {
  printf '!! %s\n' "$1" >&2
}

usage() {
  printf 'Usage: ./bin/ensure-codex-standalone [--dry-run]\n' >&2
}

standalone_install_ok() {
  [[ -x "$standalone_bin" ]] && "$standalone_bin" --version >/dev/null 2>&1
}

visible_command_ok() {
  [[ -x "$visible_bin" ]] || return 1
  [[ -L "$visible_bin" && "$(readlink "$visible_bin")" == "$standalone_bin" ]] || return 1
  "$visible_bin" --version >/dev/null 2>&1
}

install_standalone() {
  if [[ "$dry_run" -eq 1 ]]; then
    log "dry-run: would install Codex standalone with the official installer"
    return 0
  fi

  log "Installing Codex standalone"
  mkdir -p "$install_dir"
  local installer
  installer="$(mktemp)" || return 1
  curl -fsSL --connect-timeout 15 --max-time 120 --retry 2 --retry-max-time 180 https://chatgpt.com/codex/install.sh -o "$installer" || { rm -f "$installer"; return 1; }
  PATH="${install_dir}:${PATH}" \
    CODEX_NON_INTERACTIVE=1 \
    CODEX_HOME="$codex_home" \
    CODEX_INSTALL_DIR="$install_dir" \
    sh "$installer" || { rm -f "$installer"; return 1; }
  rm -f "$installer"
}

verify_codex() {
  if ! standalone_install_ok || ! visible_command_ok; then
    warn "Codex standalone command is missing or unhealthy at ${visible_bin}"
    return 1
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

export PATH="${install_dir}:${PATH}"

if ! standalone_install_ok || ! visible_command_ok; then
  install_standalone
fi

if [[ "$dry_run" -eq 1 ]]; then
  log "dry-run: would verify Codex standalone command"
  exit 0
fi

verify_codex

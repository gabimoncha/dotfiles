#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "${repo_root}/bin/lib/dotfiles-profile.sh"
. "${repo_root}/bin/lib/mise-pin.sh"
DOTFILES_PROFILE="$(dotfiles_profile)" || exit 1
export DOTFILES_PROFILE
failures=0

pass() {
  printf 'ok  - %s\n' "$1"
}

warn() {
  printf 'warn - %s\n' "$1"
}

fail() {
  printf 'fail - %s\n' "$1" >&2
  failures=$((failures + 1))
}

homebrew_bin() {
  if [[ -n "${HOMEBREW_PREFIX:-}" && -x "${HOMEBREW_PREFIX}/bin/brew" ]]; then
    printf '%s/bin/brew\n' "$HOMEBREW_PREFIX"
  elif [[ -x /opt/homebrew/bin/brew ]]; then
    printf '/opt/homebrew/bin/brew\n'
  elif [[ -x /usr/local/bin/brew ]]; then
    printf '/usr/local/bin/brew\n'
  elif command -v brew >/dev/null 2>&1; then
    command -v brew
  fi
}

check_macos() {
  if [[ "$(uname)" == "Darwin" ]]; then
    pass "running on macOS"
  else
    fail "this bootstrap is only for macOS"
  fi
}

check_linux() {
  local tool
  pass "running on Linux"
  if [[ "${EUID}" -eq 0 ]]; then
    fail "run setup as your normal user, not as root"
  fi
  if command -v apt-get >/dev/null 2>&1; then
    pass "apt is available"
  else
    fail "setup supports Debian and Ubuntu (apt); this system has no apt-get"
  fi
  for tool in /usr/bin/ruby git curl; do
    if command -v "$tool" >/dev/null 2>&1; then
      pass "${tool##*/} is available"
    else
      fail "${tool##*/} is missing; run ./bin/linux-prerequisites"
    fi
  done
  if ! command -v sudo >/dev/null 2>&1; then
    fail "sudo is missing; apt packages and the login shell need it"
  elif sudo -n true 2>/dev/null; then
    pass "sudo works without a password"
  else
    warn "sudo will ask for a password in the sudo step"
  fi
}

check_standalone_manifest() {
  local bad_rows
  bad_rows="$(awk -F '\t' 'NF != 7 && $0 !~ /^#/ && $0 != "" { print NR }' "${repo_root}/apps/standalone.tsv")"
  if [[ -z "$bad_rows" ]]; then
    pass "standalone manifest has seven TSV columns"
  else
    fail "standalone manifest malformed rows: ${bad_rows}"
  fi
}

check_macos_updates() {
  if ! "${repo_root}/bin/check-macos-updates"; then
    failures=$((failures + 1))
  fi
}

check_xcode_clt() {
  if xcode-select -p >/dev/null 2>&1; then
    pass "Xcode Command Line Tools installed"
  else
    warn "Xcode Command Line Tools missing; ./bin/setup will launch the installer and exit for a rerun"
  fi
}

check_apple_release_policy() {
  local macos_build app app_name app_name_lower plist plistbuddy_bin bundle_id xcode_build
  local prerelease_xcodes="" unknown_xcodes=""

  macos_build="$(sw_vers -buildVersion 2>/dev/null || true)"
  if [[ -z "$macos_build" ]]; then
    fail "macOS release status is unknown because the build version is not available"
  elif [[ "$macos_build" == *[[:lower:]] && "${DOTFILES_ALLOW_MACOS_BETA:-0}" == 1 ]]; then
    # Opt-in for one run: ./bin/setup --allow-macos-beta. Xcode betas still stop.
    warn "macOS build ${macos_build} appears to be a prerelease; continuing because of --allow-macos-beta"
  elif [[ "$macos_build" == *[[:lower:]] ]]; then
    fail "macOS build ${macos_build} appears to be a prerelease; turn off Beta Updates and install a public release, then rerun ./bin/setup, or pass --allow-macos-beta"
  else
    pass "macOS appears to use a public release build"
  fi

  plistbuddy_bin="${DOTFILES_PLISTBUDDY_BIN:-/usr/libexec/PlistBuddy}"
  while IFS= read -r app; do
    [[ -z "$app" ]] && continue
    app_name="$(basename "$app")"
    app_name_lower="$(printf '%s' "$app_name" | LC_ALL=C tr '[:upper:]' '[:lower:]')"
    plist="${app}/Contents/Info.plist"

    # Xcode-beta.app is a direct name signal. A renamed Xcode bundle is
    # identified by its stable bundle identifier and build metadata below.
    if [[ "$app_name_lower" == xcode* && "$app_name_lower" == *beta* ]]; then
      prerelease_xcodes="${prerelease_xcodes}${prerelease_xcodes:+, }${app_name}"
      continue
    fi

    if [[ ! -f "$plist" || ! -x "$plistbuddy_bin" ]]; then
      if [[ "$app_name_lower" == xcode* ]]; then
        unknown_xcodes="${unknown_xcodes}${unknown_xcodes:+, }${app_name}"
      fi
      continue
    fi

    bundle_id="$("$plistbuddy_bin" -c 'Print :CFBundleIdentifier' "$plist" 2>/dev/null || true)"
    if [[ "$bundle_id" != "com.apple.dt.Xcode" ]]; then
      continue
    fi
    # The App Store offers only public releases.
    if [[ -f "${app}/Contents/_MASReceipt/receipt" ]]; then
      continue
    fi

    xcode_build="$("$plistbuddy_bin" -c 'Print :DTXcodeBuild' "$plist" 2>/dev/null || true)"
    if [[ -z "$xcode_build" ]]; then
      unknown_xcodes="${unknown_xcodes}${unknown_xcodes:+, }${app_name}"
    elif [[ "$xcode_build" == *[[:lower:]] ]]; then
      prerelease_xcodes="${prerelease_xcodes}${prerelease_xcodes:+, }${app_name} (${xcode_build})"
    fi
  done < <(find "${DOTFILES_APPLICATIONS_DIR:-/Applications}" -maxdepth 1 -type d -name '*.app' -print 2>/dev/null | sort)

  if [[ -n "$prerelease_xcodes" ]]; then
    fail "prerelease Xcode apps remain installed: ${prerelease_xcodes}; install and select the public release, then rerun ./bin/setup"
  elif [[ -n "$unknown_xcodes" ]]; then
    fail "Xcode prerelease status is unknown because bundle metadata could not be read for: ${unknown_xcodes}"
  else
    pass "no prerelease Xcode app name or build metadata was found"
  fi
}

check_homebrew() {
  local brew_cmd

  brew_cmd="$(homebrew_bin || true)"
  if [[ -n "$brew_cmd" ]]; then
    pass "Homebrew found"
    if "$brew_cmd" --prefix >/dev/null 2>&1; then
      pass "Homebrew prefix is usable"
    else
      warn "brew exists but brew --prefix failed; the Homebrew foundation will report readiness independently"
    fi
  else
    warn "Homebrew not found; ./bin/setup will install it"
  fi
}

# Check every tracked shell script: the ones with a sh, bash, or zsh shebang,
# and the zsh startup files. The installed agent skills are third-party code
# that the skills CLI replaces on update, so this check skips them.
check_script_syntax() {
  local script first shell
  while IFS= read -r script; do
    [[ -f "${repo_root}/${script}" && ! -L "${repo_root}/${script}" ]] || continue
    IFS= read -r first <"${repo_root}/${script}" || first=""
    case "$first" in
      '#!'*zsh*) shell=zsh ;;
      '#!'*bash*) shell=bash ;;
      '#!'*/sh) shell=sh ;;
      *)
        case "$script" in
          configs/zsh/*.zsh | configs/zsh/zshrc | configs/zsh/zshenv | configs/zsh/zprofile) shell=zsh ;;
          configs/bash/*.bash | configs/bash/bash_profile | *.sh) shell=bash ;;
          *) continue ;;
        esac
        ;;
    esac
    if [[ "$shell" == zsh ]] && ! command -v zsh >/dev/null 2>&1; then
      warn "zsh is not installed; skipped ${script}"
      continue
    fi
    if "$shell" -n "${repo_root}/${script}"; then
      pass "syntax: ${script}"
    else
      fail "syntax error: ${script}"
    fi
  done < <(git -C "$repo_root" ls-files -- bin macos configs ':!configs/agents/skills')
}

# Each `source` in the root mise files names a file that exists, and each file
# in configs/ is a source or sits in a source folder. A source that starts with
# ~/ or / is on the host, such as a tool that setup installs, so this check
# skips it. A source with a * is a glob, such as configs/agents/skills/*, and
# must match at least one file. The exceptions to the second rule: the
# Cursor telemetry files, which bin/configure-telemetry applies, and the
# sync-keys lists of bin/save-settings.
check_layout() {
  local sources source file skill_files used missing=0 unused=0
  sources="$(sed -n 's/.*source = "\([^"]*\)".*/\1/p' "$repo_root"/mise.toml "$repo_root"/mise.*.toml | sort -u)"
  while IFS= read -r source; do
    [[ -n "$source" ]] || continue
    case "$source" in "~/"* | /*) continue ;; esac
    if [[ "$source" == *'*'* ]]; then
      compgen -G "${repo_root}/${source}" >/dev/null && continue
      fail "a mise file names a glob that matches nothing: ${source}"
      missing=1
    elif [[ ! -e "${repo_root}/${source}" ]]; then
      fail "a mise file names a missing source: ${source}"
      missing=1
    fi
  done <<<"$sources"
  [[ "$missing" == 1 ]] || pass "every source in the mise files exists"
  while IFS= read -r file; do
    used=0
    while IFS= read -r source; do
      [[ -n "$source" ]] || continue
      # shellcheck disable=SC2053 # A glob source matches as a pattern.
      if [[ "$file" == "$source" || "$file" == "$source/"* ]] ||
        [[ "$source" == *'*'* && "$file" == $source ]]; then
        used=1
        break
      fi
    done <<<"$sources"
    case "$file" in configs/cursor/telemetry-*.json | configs/*/sync-keys) used=1 ;; esac
    [[ "$used" == 1 ]] && continue
    fail "no mise file uses ${file}"
    unused=1
  done < <(git -C "$repo_root" ls-files -- configs)
  [[ "$unused" == 1 ]] || pass "every file in configs/ is used"
  # An AGENTS.md or CLAUDE.md in a subfolder would give agents wrong rules.
  # A third-party skill can ship one. The skills CLI replaces a renamed file
  # on the next update, so a skill's file only warns.
  file="$(git -C "$repo_root" ls-files | grep -E '(^|/)(AGENTS|CLAUDE)\.md$' | grep -vx 'AGENTS.md' || true)"
  skill_files="$(printf '%s\n' "$file" | grep '^configs/agents/skills/' || true)"
  file="$(printf '%s\n' "$file" | grep -v '^configs/agents/skills/' || true)"
  if [[ -z "$file" ]]; then
    pass "AGENTS.md exists only at the repository root"
  else
    fail "rename these agent instruction files: ${file//$'\n'/ }"
  fi
  [[ -z "$skill_files" ]] || warn "agents that edit these skill folders also read: ${skill_files//$'\n'/ }"
}

# Checks that need the pinned mise. A new machine has no mise yet, so these
# checks only warn there. config explain marks keys that mise does not know or
# reads only for an older spelling. lock --sidecars lists the dependency-graph
# folders that the locks name. bootstrap status compares this machine with the
# root mise files.
check_mise_config() {
  local mise_bin="${MISE_INSTALL_PATH:-${HOME}/.local/bin/mise}" file scope findings bad=0
  if ! mise_at_pin "$mise_bin"; then
    warn "mise ${pinned_mise_version} is not installed; skipped the mise config checks"
    return 0
  fi
  if [[ ! -x /usr/bin/ruby ]]; then
    warn "/usr/bin/ruby is missing; skipped the mise config checks"
    return 0
  fi
  while IFS= read -r file; do
    case "$file" in
      configs/mise/config/config*.toml) scope=--global ;;
      mise.toml | mise.*.toml) scope= ;;
      *) continue ;;
    esac
    findings="$("${repo_root}/bin/repo-mise" ${scope:+"$scope"} config explain --file "${repo_root}/${file}" --json 2>/dev/null |
      /usr/bin/ruby -rjson -e '
        JSON.parse($stdin.read).each do |key|
          next if key["known"] && !key["deprecated"]
          puts "line #{key["line"]}: #{key["key"]} (#{key["known"] ? "deprecated" : "unknown"})"
        end')" || {
      fail "mise could not explain ${file}"
      bad=1
      continue
    }
    [[ -z "$findings" ]] && continue
    fail "${file} has keys to fix: ${findings//$'\n'/; }"
    bad=1
  done < <(git -C "$repo_root" ls-files -- 'mise.toml' 'mise.*.toml' 'configs/mise/config/config*.toml')
  [[ "$bad" == 1 ]] || pass "the mise files use only current keys"

  # bin/save-lock commits the sidecars only from configs/mise/config/locks.
  findings="$("${repo_root}/bin/repo-mise" --global lock --global --sidecars --json 2>/dev/null |
    /usr/bin/ruby -rjson -e '
      JSON.parse($stdin.read).each do |lock|
        lock["sidecars"].each do |s|
          puts "#{s["tool"]}@#{s["version"]} is missing" unless s["exists"]
          puts "#{s["tool"]}@#{s["version"]} is outside configs/mise/config/locks" unless s["path"].include?("/configs/mise/config/locks/")
        end
      end')" || findings="the sidecar list failed"
  if [[ -z "$findings" ]]; then
    pass "every lock sidecar exists in configs/mise/config/locks"
  else
    fail "lock sidecars: ${findings//$'\n'/; }. Run ./bin/repo-mise --global lock --global, then commit configs/mise/config/locks"
  fi

  if "${repo_root}/bin/repo-mise" bootstrap status --missing >/dev/null 2>&1; then
    pass "this machine matches the bootstrap and dotfiles entries"
  else
    warn "this machine differs from the mise files; run ./bin/repo-mise bootstrap status"
  fi
}

check_repo_state() {
  local file
  if git -C "$repo_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    pass "dotfiles git repo detected"
  else
    fail "not inside a git repo"
  fi
  for file in Brewfile apps/devhost.Brewfile mise.toml mise.devhost.toml configs/mise/config/config.toml \
    configs/mise/config/config.devhost.toml configs/mise/config/config.air.toml apps/manifest.tsv; do
    if [[ -f "${repo_root}/${file}" ]]; then
      pass "${file} present"
    else
      fail "${file} missing"
    fi
  done
}

check_sudo_grant() {
  local output
  if output="$("${repo_root}/bin/sudo-grant" --check)"; then
    pass "${output#ok  - }"
  else
    warn "${output#warn - }"
  fi
}

check_app_manifest() {
  local bad_rows manifest

  for manifest in "${repo_root}"/apps/manifest.tsv "${repo_root}"/apps/manifest.*.tsv; do
    [[ -f "$manifest" ]] || continue
    bad_rows="$(awk -F '\t' 'NF != 5 && $0 !~ /^#/ && $0 != "" { print NR }' "$manifest")"
    if [[ -z "$bad_rows" ]]; then
      pass "${manifest#"${repo_root}/"} has five TSV columns"
    else
      fail "${manifest#"${repo_root}/"} malformed rows: ${bad_rows//$'\n'/ }"
    fi
  done
}

case "$(uname -s)" in
  Darwin)
    check_macos
    check_macos_updates
    check_xcode_clt
    check_apple_release_policy
    check_homebrew
    ;;
  Linux) check_linux ;;
  *) fail "setup supports macOS and Linux, not $(uname -s)" ;;
esac
# API and SSH checks belong to the authentication steps.
check_repo_state
check_layout
check_mise_config
check_app_manifest
check_standalone_manifest
# The temporary sudoers grant is part of the macOS plan only.
[[ "$(uname -s)" != Darwin ]] || check_sudo_grant
check_script_syntax

if [[ $failures -gt 0 ]]; then
  printf '\nPreflight failed with %s issue(s).\n' "$failures" >&2
  exit 1
fi

printf '\nPreflight passed.\n'

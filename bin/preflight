#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
failures=0

pass() {
  printf 'ok  - %s\n' "$1"
}

warn() {
  printf 'warn - %s\n' "$1"
}

fail() {
  printf 'fail - %s\n' "$1" >&2
  failures=$((failures + 1))
}

homebrew_bin() {
  if [[ -n "${HOMEBREW_PREFIX:-}" && -x "${HOMEBREW_PREFIX}/bin/brew" ]]; then
    printf '%s/bin/brew\n' "$HOMEBREW_PREFIX"
  elif [[ -x /opt/homebrew/bin/brew ]]; then
    printf '/opt/homebrew/bin/brew\n'
  elif [[ -x /usr/local/bin/brew ]]; then
    printf '/usr/local/bin/brew\n'
  elif command -v brew >/dev/null 2>&1; then
    command -v brew
  fi
}

check_macos() {
  if [[ "$(uname)" == "Darwin" ]]; then
    pass "running on macOS"
  else
    fail "this bootstrap is only for macOS"
  fi
}

check_macos_updates() {
  if ! "${repo_root}/bin/check-macos-updates"; then
    failures=$((failures + 1))
  fi
}

check_xcode_clt() {
  if xcode-select -p >/dev/null 2>&1; then
    pass "Xcode Command Line Tools installed"
  else
    warn "Xcode Command Line Tools missing; ./bin/bootstrap will launch the installer and exit for a rerun"
  fi
}

check_apple_release_policy() {
  local macos_build app app_name app_name_lower plist plistbuddy_bin bundle_id xcode_build
  local prerelease_xcodes="" unknown_xcodes=""

  macos_build="$(sw_vers -buildVersion 2>/dev/null || true)"
  if [[ -z "$macos_build" ]]; then
    fail "macOS release status is unknown because the build version is not available"
  elif [[ "$macos_build" == *[[:lower:]] ]]; then
    fail "macOS build ${macos_build} appears to be a prerelease; turn off Beta Updates and install a public release, then rerun ./bin/setup"
  else
    pass "macOS appears to use a public release build"
  fi

  plistbuddy_bin="${DOTFILES_PLISTBUDDY_BIN:-/usr/libexec/PlistBuddy}"
  while IFS= read -r app; do
    [[ -z "$app" ]] && continue
    app_name="$(basename "$app")"
    app_name_lower="$(printf '%s' "$app_name" | LC_ALL=C tr '[:upper:]' '[:lower:]')"
    plist="${app}/Contents/Info.plist"

    # Xcode-beta.app is a direct name signal. A renamed Xcode bundle is
    # identified by its stable bundle identifier and build metadata below.
    if [[ "$app_name_lower" == xcode* && "$app_name_lower" == *beta* ]]; then
      prerelease_xcodes="${prerelease_xcodes}${prerelease_xcodes:+, }${app_name}"
      continue
    fi

    if [[ ! -f "$plist" || ! -x "$plistbuddy_bin" ]]; then
      if [[ "$app_name_lower" == xcode* ]]; then
        unknown_xcodes="${unknown_xcodes}${unknown_xcodes:+, }${app_name}"
      fi
      continue
    fi

    bundle_id="$("$plistbuddy_bin" -c 'Print :CFBundleIdentifier' "$plist" 2>/dev/null || true)"
    if [[ "$bundle_id" != "com.apple.dt.Xcode" ]]; then
      continue
    fi

    xcode_build="$("$plistbuddy_bin" -c 'Print :DTXcodeBuild' "$plist" 2>/dev/null || true)"
    if [[ -z "$xcode_build" ]]; then
      unknown_xcodes="${unknown_xcodes}${unknown_xcodes:+, }${app_name}"
    elif [[ "$xcode_build" == *[[:lower:]] ]]; then
      prerelease_xcodes="${prerelease_xcodes}${prerelease_xcodes:+, }${app_name} (${xcode_build})"
    fi
  done < <(find "${DOTFILES_APPLICATIONS_DIR:-/Applications}" -maxdepth 1 -type d -name '*.app' -print 2>/dev/null | sort)

  if [[ -n "$prerelease_xcodes" ]]; then
    fail "prerelease Xcode apps remain installed: ${prerelease_xcodes}; install and select the public release, then rerun ./bin/setup"
  elif [[ -n "$unknown_xcodes" ]]; then
    warn "Xcode prerelease status is unknown because bundle metadata could not be read for: ${unknown_xcodes}"
  else
    pass "no prerelease Xcode app name or build metadata was found"
  fi
}

check_homebrew() {
  local brew_cmd

  brew_cmd="$(homebrew_bin || true)"
  if [[ -n "$brew_cmd" ]]; then
    pass "Homebrew found"
    if "$brew_cmd" --prefix >/dev/null 2>&1; then
      pass "Homebrew prefix is usable"
    else
      fail "brew exists but brew --prefix failed"
    fi
  else
    warn "Homebrew not found; ./bin/bootstrap will install it"
  fi
}

check_github_ssh() {
  local output status

  if ! command -v ssh >/dev/null 2>&1; then
    warn "ssh is not available; install Xcode Command Line Tools, then rerun ./bin/setup"
    return 0
  fi

  set +e
  output="$(ssh -o BatchMode=yes -o ConnectTimeout=5 -T git@github.com 2>&1)"
  status=$?
  set -e

  if [[ "$output" == *"successfully authenticated"* ]]; then
    pass "GitHub SSH authenticated"
  elif [[ $status -eq 255 ]]; then
    warn "GitHub SSH is not ready; ./bin/setup will run ./bin/auth-setup before bootstrap"
  else
    warn "GitHub SSH returned: ${output}"
  fi
}

check_submodule_url() {
  local url

  url="$(git -C "$repo_root" config --file .gitmodules --get submodule.nvim.url || true)"
  case "$url" in
    ../nvim | https://github.com/gabimoncha/nvim | https://github.com/gabimoncha/nvim.git)
      pass "nvim submodule uses public-friendly URL"
      ;;
    git@github.com:* | ssh://*)
      fail "nvim submodule URL requires SSH: ${url}"
      ;;
    *)
      fail "nvim submodule URL should be ../nvim or HTTPS, got: ${url:-missing}"
      ;;
  esac
}

check_script_syntax() {
  local script
  local scripts=(
    "bin/bootstrap"
    "bin/check-macos-updates"
    "bin/setup"
    "bin/lib/setup-runtime.sh"
    "bin/link-dotfiles"
    "bin/preflight"
    "bin/auth-setup"
    "bin/check-mise-tools"
    "bin/configure-sudo-touch-id"
    "bin/ensure-codex-standalone"
    "bin/ensure-cursor-agent-standalone"
    "bin/ensure-mise-standalone"
    "bin/install-apps"
    "bin/install-mobile-dev"
    "bin/finder-sidebar-favorites"
    "bin/setup-tmux"
    "bin/app-state-doctor"
    "bin/dotfiles-update"
    "bin/prepare-sync"
    "bin/file-backup"
    "bin/file-restore"
    "bin/codex-backup"
    "bin/codex-restore"
    "bin/mackup-backup"
    "bin/mackup-restore"
    "bin/raycast-backup"
    "bin/raycast-restore"
    "macos/defaults.sh"
  )

  for script in "${scripts[@]}"; do
    if [[ -f "${repo_root}/${script}" ]]; then
      if bash -n "${repo_root}/${script}"; then
        pass "syntax: ${script}"
      else
        fail "syntax error: ${script}"
      fi
    else
      fail "missing script: ${script}"
    fi
  done
}

check_repo_state() {
  if git -C "$repo_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    pass "dotfiles git repo detected"
  else
    fail "not inside a git repo"
  fi

  if [[ -f "${repo_root}/Brewfile" ]]; then
    pass "Brewfile present"
  else
    fail "Brewfile missing"
  fi

  if [[ -f "${repo_root}/home/.config/mise/config.toml" ]]; then
    pass "mise config present"
  else
    fail "mise config missing"
  fi

  if [[ -f "${repo_root}/apps/manifest.tsv" ]]; then
    pass "app manifest present"
  else
    fail "app manifest missing"
  fi
}

check_app_manifest() {
  local bad_rows

  bad_rows="$(awk -F '\t' 'NF != 5 && $0 !~ /^#/ && $0 != "" { print NR }' "${repo_root}/apps/manifest.tsv")"
  if [[ -z "$bad_rows" ]]; then
    pass "app manifest has five TSV columns"
  else
    fail "app manifest malformed rows: ${bad_rows}"
  fi
}

check_macos
check_macos_updates
check_xcode_clt
check_apple_release_policy
check_homebrew
check_github_ssh
check_submodule_url
check_repo_state
check_app_manifest
check_script_syntax

if [[ $failures -gt 0 ]]; then
  printf '\nPreflight failed with %s issue(s).\n' "$failures" >&2
  exit 1
fi

printf '\nPreflight passed.\n'

amends "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Builtins.pkl"

// Bash and POSIX sh scripts. Most have no file extension, so list them by path.
local shellFiles =
  List(
    "bin/*",
    "bin/lib/*.sh",
    "configs/bash/*.bash",
    "configs/claude/claude",
    "configs/gh/gh",
    "configs/gh/dotfiles-gh-real",
    "configs/harness/harness",
    "configs/karabiner/*.sh",
    "configs/npx/npx",
    "configs/tsrs/tsgo",
    "configs/zsh/telemetry.sh",
    "macos/*.sh",
    "macos/dotfiles-telemetry-env",
  )

local zshFiles = List("configs/zsh/*.zsh", "configs/zsh/zprofile", "configs/zsh/zshenv", "configs/zsh/zshrc")

// p10k.zsh is generated by the Powerlevel10k configuration wizard.
local generated = List("configs/zsh/p10k.zsh")

local appWritten = List("configs/**/*.json")

local hookSteps = new Mapping<String, Step> {
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["detect-private-key"] = Builtins.detect_private_key
  ["mixed-line-ending"] = Builtins.mixed_line_ending
  // Apps write these JSON files themselves, often with no final newline.
  ["newlines"] = (Builtins.newlines) { exclude = appWritten }
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) { exclude = appWritten }
  ["shfmt"] {
    glob = shellFiles
    exclude = List("bin/lib/*.rb")
    check = "shfmt -d -i 2 -ci {{files}}"
    fix = "shfmt -w -i 2 -ci {{files}}"
  }
  ["shfmt-zsh"] {
    glob = zshFiles
    exclude = generated
    check = "shfmt -d -i 2 -ci -ln zsh {{files}}"
    fix = "shfmt -w -i 2 -ci -ln zsh {{files}}"
  }
  // oxfmt keeps line breaks in prose and pads tables so their columns line up.
  ["oxfmt"] = (Builtins.oxfmt) {
    glob = List("**/*.md", "**/*.json", "**/*.toml", "**/*.yaml", "**/*.yml")
    exclude = appWritten
  }
  // Fails only on errors for now. Raise the severity in a later change.
  ["shellcheck"] {
    glob = shellFiles
    exclude = List("bin/lib/*.rb")
    check = "shellcheck -S error {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = hookSteps
  }
  ["check"] {
    steps = hookSteps
  }
  ["fix"] {
    fix = true
    steps = hookSteps
  }
}

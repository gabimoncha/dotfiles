[user]
	name = gabimoncha
	email = 39256258+gabimoncha@users.noreply.github.com
[core]
	ignorecase = false
[push]
	autoSetupRemote = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[init]
	defaultBranch = main
# hk git hooks, from `hk install --global`. They need git 2.54 or newer. A repo
# without an hk.pkl skips them. HK=0 skips them for one command.
[hook "hk-commit-msg"]
	command = test \"${HK:-1}\" = \"0\" || ~/.local/share/mise/shims/hk run commit-msg --from-hook
	event = commit-msg
[hook "hk-pre-commit"]
	command = test \"${HK:-1}\" = \"0\" || ~/.local/share/mise/shims/hk run pre-commit --from-hook --staged
	event = pre-commit
[hook "hk-pre-push"]
	command = test \"${HK:-1}\" = \"0\" || ~/.local/share/mise/shims/hk run pre-push --from-hook
	event = pre-push
[hook "hk-prepare-commit-msg"]
	command = test \"${HK:-1}\" = \"0\" || ~/.local/share/mise/shims/hk run prepare-commit-msg --from-hook
	event = prepare-commit-msg
[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper =
	helper = !$HOME/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !$HOME/bin/gh auth git-credential

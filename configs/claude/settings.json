{
  "theme": "dark",
  "editorMode": "vim",
  "tui": "fullscreen",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "autoUpdatesChannel": "latest",
  "autoCompactEnabled": true,
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h",
  "autoMemoryEnabled": false,
  "askUserQuestionTimeout": "never",
  "dialogExpiry": "never",
  "preferredNotifChannel": "auto",
  "switchModelsOnFlag": true,
  "teammateMode": "tmux",
  "useAutoModeDuringPlan": true,
  "skipDangerousModePermissionPrompt": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CLAUDE_ENV_FILE\" ] || grep -qsF 'mise hook-env --force' \"$CLAUDE_ENV_FILE\" || printf '%s\\n' '[ -n \"${__MISE_TASK_TOOL_ARGS-}${MISE_TASK_NAME-}\" ] || eval \"$(mise hook-env --force -s \"${ZSH_VERSION:+zsh}${BASH_VERSION:+bash}\")\"' >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ]
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "0"
  }
}

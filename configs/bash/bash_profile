# shellcheck shell=bash
# A login bash (`bash -l`) reads this file instead of ~/.profile. Debian's
# /etc/profile sets a new PATH, so a login bash loses the mise tools of its
# parent shell. On macOS, a login bash that starts with a clean environment
# has no mise tools either. Read ~/.profile as before, then activate mise.
# ~/.profile stays a local file, because hosts add their own lines to it.
if [ -f "$HOME/.profile" ]; then
  . "$HOME/.profile"
fi
if [ -f "$HOME/.config/bash/mise-activate.bash" ]; then
  . "$HOME/.config/bash/mise-activate.bash"
fi

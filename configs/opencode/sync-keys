# Settings of ~/.config/opencode/opencode.json that bin/save-settings copies
# into configs/opencode/opencode.json. A public rule names one setting. A
# private rule can name a whole section. Each key in configs/opencode/opencode.json
# needs a public rule. Settings on neither list are counted, not saved: run
# ./bin/save-settings --show-new to list them.
public .$schema
public .provider.fs.npm
public .provider.fs.name
public .provider.fs.options.apiKey
public .provider.fs.models
# The proxy URL is private. Set it in the live file on each machine.
private .provider.fs.options.baseURL

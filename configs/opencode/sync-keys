public .provider.fs.models.sol-medium.name
public .provider.fs.models.sol-high.id
public .provider.fs.models.sol-high.name
public .provider.fs.models.sol-xhigh.id
public .provider.fs.models.sol-xhigh.name
public .provider.fs.models.argon-low.id
public .provider.fs.models.argon-low.name
public .provider.fs.models.argon-medium.id
public .provider.fs.models.argon-medium.name
public .provider.fs.models.argon-high.id
public .provider.fs.models.argon-high.name

#!/usr/bin/env bash
# Deliberately never invoke mise, PATH gh, or the account-routing wrapper here.
set -euo pipefail
resolve() {
  local root candidate version
  root="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/installs/gh"
  # Numeric version directories only: ignore shims, aliases and incomplete installs.
  while IFS= read -r version; do
    [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
    # Backends either flatten the archive or retain gh's release directory.
    for candidate in "${root}/${version}/bin/gh" \
      "${root}/${version}/gh_${version}_macOS_arm64/bin/gh" \
      "${root}/${version}/gh_${version}_macOS_amd64/bin/gh"; do
      [[ -x "$candidate" && ! -L "$candidate" && ! -L "$(dirname "$candidate")" && ! -L "$(dirname "$(dirname "$candidate")")" ]] || continue
      "$candidate" --version >/dev/null 2>&1 || continue
      printf '%s\n' "$candidate"
      return 0
    done
  done < <(for candidate in "$root"/*; do [[ -d "$candidate" && ! -L "$candidate" ]] && basename "$candidate"; done | sort -t . -k1,1nr -k2,2nr -k3,3nr)
  printf 'gh: no complete managed GitHub CLI installation; rerun ./bin/setup\n' >&2
  return 127
}
real_gh="$(resolve)"
if [[ "${1:-}" == --resolve ]]; then
  printf '%s\n' "$real_gh"
else
  exec "$real_gh" "$@"
fi

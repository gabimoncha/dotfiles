.DS_Store
*.bak
*.orig
.env
.sync-backups/
*.rayconfig
codex-state-*.tar.gz.age

# Local-only shell config and secrets. Keep examples tracked.
home/.config/local/*
!home/.config/local/
!home/.config/local/*.example

# CLIProxyAPI auth state stays local; only its secret-free config is tracked.
home/.cli-proxy-api/*
!home/.cli-proxy-api/
!home/.cli-proxy-api/config.yaml

# Local worktree noise from nested repos/submodules.
.submodule-seed/

.DS_Store
*.bak
*.orig
.env
.sync-backups/
*.rayconfig
codex-state-*.tar.gz.age

# Local worktree noise from nested repos/submodules.
.submodule-seed/

# Generated diagnostics and local working files.
/.local/

# This machine's profile and local mise overrides.
/.miserc.local.toml
mise.local.toml
mise.*.local.toml

# Local companions stay on this machine. Keep the examples tracked.
/local/*
!/local/*.example

# CLIProxyAPI writes its auth state next to its config. Track the config only.
/configs/cliproxyapi/*
!/configs/cliproxyapi/config.yaml

# Local files from the old layout stay ignored until bin/link-dotfiles moves
# them on every machine.
/home/
/cliproxyapi/
/mise/setup/miserc.local.toml

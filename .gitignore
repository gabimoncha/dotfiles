.DS_Store
*.bak
*.orig
.env
.sync-backups/
*.rayconfig
codex-state-*.tar.gz.age

# Local-only shell config and secrets. Keep examples tracked.
home/.config/local/*
!home/.config/local/
!home/.config/local/*.example

# CLIProxyAPI auth state stays local; only its secret-free config is tracked.
home/.cli-proxy-api/*
!home/.cli-proxy-api/
!home/.cli-proxy-api/config.yaml

# Local worktree noise from nested repos/submodules.
.submodule-seed/

# Generated diagnostics and local working files.
/.local/

# Native setup selection and local companions stay on this machine.
/mise/setup/miserc.local.toml
/local/*
!/local/*.example
/cliproxyapi/*
!/cliproxyapi/config.yaml
!/cliproxyapi/mise.macos.toml
